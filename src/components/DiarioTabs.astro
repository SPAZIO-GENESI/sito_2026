---
import { u } from '../utils/url'

interface Props {
  active: 'attivita' | 'news' | 'comunicazioni'
}
const { active } = Astro.props

const tabs = [
  { key: 'attivita', label: 'Attività', href: u('/attivita/') },
  { key: 'news', label: 'News', href: u('/news/') },
  { key: 'comunicazioni', label: 'Vita associativa', href: u('/vita-associativa/') },
]
---
<nav aria-label="Sezioni del Diario" class="flex flex-wrap gap-2">
  {tabs.map((t) => (
    <a
      href={t.href}
      aria-current={active === t.key ? 'page' : undefined}
      class={`inline-flex items-center px-5 py-2.5 rounded-full text-sm font-semibold transition-colors ${
        active === t.key
          ? 'bg-accent text-accent-foreground'
          : 'border border-border bg-background text-foreground hover:border-accent hover:text-accent'
      }`}
    >
      {t.label}
    </a>
  ))}
</nav>
