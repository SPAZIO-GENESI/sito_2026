---
import { u } from '../utils/url'
---
<footer class="bg-muted text-foreground py-16 border-t border-border mt-24" data-pagefind-ignore>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">

      <!-- About -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Spazio Genesi</h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          Laboratorio permanente di interazione, autogestito, riservato ad iscritti ABAQ e Erasmus.
          Rotazione espositiva, archivio donazioni, caffè letterario, assemblea aperta, spazio safe.
        </p>
      </div>

      <!-- Contatti — senza Instagram (già in Profili Social) -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Contatti</h3>
        <div class="space-y-3 text-sm">
          <div class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="mt-0.5 shrink-0 text-muted-foreground" aria-hidden="true">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
            <p class="text-muted-foreground">
              Spazio Genesi ETS — CF 96602450585<br>
              Iscritta al RUNTS — rep. n. 174701, in data 15/06/2026<br>
              <a href={u('/5x1000/')} class="text-foreground font-medium hover:text-accent transition-colors">
                Sostienici col 5×1000 — CF 96602450585
              </a><br>
              <a href="https://maps.app.goo.gl/3JEsBLW5Xx8aE2mj9" target="_blank" rel="noopener noreferrer"
                class="hover:text-accent transition-colors">
                Galleria Via Roma o da Via Vicentini, L'Aquila (AQ)
              </a>
            </p>
          </div>
          <div class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="shrink-0 text-muted-foreground" aria-hidden="true">
              <path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/>
              <rect x="2" y="4" width="20" height="16" rx="2"/>
            </svg>
            <div class="space-y-0.5">
              <a href="mailto:info@spaziogenesi.org" class="text-muted-foreground hover:text-accent transition-colors block">
                info@spaziogenesi.org
              </a>
              <a href="mailto:spaziogenesi@pec.it" class="text-muted-foreground hover:text-accent transition-colors block font-medium">
                spaziogenesi@pec.it <span class="text-xs font-normal opacity-70">(PEC)</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Lo spazio è concesso da -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Lo spazio è concesso da</h3>
        <a href="https://feelitshop.com/" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-muted-foreground hover:text-accent transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1382 713" height="32px" version="1.1" aria-label="Feel it!">
            <g>
              <path fill="rgb(70%,70%,70%)" d="M 429 184 L 451 181 L 445 221 L 341 237 L 322 371 L 299 371 L 323 217 Z"/>
              <path fill="rgb(70%,70%,70%)" d="M 624 154 L 646 151 L 640 191 L 536 207 L 517 341 L 494 341 L 518 187 Z"/>
              <path fill="rgb(70%,70%,70%)" d="M 717 139 L 737 136 L 678 537 L 655 540 Z"/>
              <path fill="currentColor" d="M 71 206 L 219 180 L 214 220 L 108 237 L 84 404 L 182 390 L 179 430 L 77 447 L 43 673 L 0 679 Z"/>
              <path fill="currentColor" d="M 271 174 L 417 149 L 412 189 L 309 205 L 283 374 L 383 358 L 377 399 L 277 414 L 249 600 L 351 585 L 344 625 L 199 648 Z"/>
              <path fill="currentColor" d="M 468 140 L 613 115 L 608 155 L 505 171 L 479 340 L 579 324 L 573 365 L 473 380 L 445 566 L 547 551 L 540 591 L 395 614 Z"/>
              <path fill="currentColor" d="M 664 110 L 707 103 L 640 538 L 741 522 L 735 562 L 591 584 Z"/>
              <path fill="currentColor" d="M 948 63 L 991 56 L 917 531 L 874 537 Z"/>
              <path fill="currentColor" d="M 1208 417 L 1257 246 L 1194 259 L 1273 16 L 1354 0 L 1274 195 L 1333 186 Z"/>
              <path fill="currentColor" d="M 1012 92 L 1018 51 L 1202 22 L 1196 62 L 1127 72 L 1058 509 L 1016 515 L 1084 79 Z"/>
            </g>
          </svg>
          Feel it!
        </a>
      </div>

    </div>

    <div class="border-t border-border pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-muted-foreground">
        &copy; {new Date().getFullYear()} Spazio Genesi ETS. Tutti i diritti riservati. - Realizzato da <a href="https://tangram.page" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors font-medium">
          Tangram
        </a>.
      </p>
      <div class="flex gap-4">
        <a href={u('/privacy-policy/')}
          class="text-xs text-muted-foreground hover:text-accent transition-colors">
          Privacy Policy
        </a>
        <a href={u('/cookie-policy/')}
          class="text-xs text-muted-foreground hover:text-accent transition-colors">
          Cookie Policy
        </a>
      </div>
    </div>

    <div class="border-t border-border pt-8 mt-8 flex justify-center">
      <a href="https://elevenlabs.io/impact-program" target="_blank" rel="noopener noreferrer">
        <img src="https://eleven-public-cdn.elevenlabs.io/payloadcms/rxk2xwmcbb-elevenlabs-logo-black.svg"
          alt="ElevenLabs Impact Program" class="h-6 w-auto dark:invert" />
      </a>
    </div>
  </div>
</footer>
