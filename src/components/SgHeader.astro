---
import { u } from '../utils/url'

interface Props {
  activePage?: string
}
const { activePage = '' } = Astro.props

const navLinks = [
  { href: u('/grafo/'), label: 'Semantica', key: 'grafo' },
  { href: u('/biografie/'), label: 'Biografie', key: 'biografie' },
  { href: u('/archivio/'), label: 'Archivio', key: 'archivio' },
  { href: u('/attivita/'), label: 'Attività', key: 'attivita' },
  { href: u('/servizi/'), label: 'Servizi', key: 'servizi' },
  { href: u('/iscrizione/'), label: 'Iscrizione', key: 'iscrizione' },
  { href: u('/chisiamo/'), label: 'Chi siamo', key: 'chisiamo' },
]
---
<header class="sticky top-0 z-50 bg-background/95 backdrop-blur-sm border-b border-border" data-pagefind-ignore>
  <nav class="max-w-7xl mx-auto px-6 lg:px-8 py-4 flex items-center justify-between">
    <a href={u('/')} class="flex items-center gap-3 text-xl lg:text-2xl font-semibold text-foreground hover:text-accent transition-colors">
      <svg version="1.0" xmlns="http://www.w3.org/2000/svg"
        width="36px" viewBox="0 0 580 481"
        preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <g transform="translate(0,481) scale(0.1,-0.1)" fill="currentColor" stroke="none">
          <path d="M2175 4799 c-729 -75 -1378 -467 -1780 -1074 -82 -124 -203 -366
          -252 -505 -100 -282 -137 -506 -137 -815 0 -222 6 -283 46 -497 l23 -118 1396
          0 1397 0 26 -83 c37 -117 49 -216 43 -332 -24 -405 -299 -739 -698 -847 -120
          -32 -328 -32 -448 0 -105 29 -210 76 -301 138 -77 51 -201 176 -240 242 l-25
          41 -368 1 -368 0 63 -76 c142 -172 345 -355 533 -479 124 -82 366 -203 505
          -252 281 -100 505 -137 815 -137 310 0 534 37 815 137 139 49 381 170 505 252
          265 175 514 425 690 690 94 141 214 391 269 558 l49 147 534 0 533 0 0 565 0
          565 -1944 0 -1943 0 -27 59 c-53 119 -70 203 -70 361 0 168 18 251 84 388 51
          106 88 161 169 246 83 86 166 145 275 197 142 66 218 82 391 82 122 0 165 -4
          228 -21 99 -27 232 -89 310 -146 74 -52 190 -172 232 -238 l30 -48 413 0 c226
          0 412 2 412 5 0 14 -172 214 -256 299 -190 190 -374 323 -619 447 -232 117
          -479 196 -735 234 -127 19 -452 27 -575 14z"/>
        </g>
      </svg>
      Spazio Genesi
    </a>

    <!-- Desktop nav -->
    <ul class="hidden md:flex items-center gap-6 lg:gap-10">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`text-sm lg:text-base font-medium transition-colors border-b-2 ${
              activePage === link.key
                ? 'border-accent text-accent'
                : 'border-transparent text-foreground hover:text-accent'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Search icon -->
    <a href={u('/cerca/')}
      aria-label="Cerca nel sito"
      class={`hidden md:flex items-center justify-center p-1 rounded transition-colors ${activePage === 'cerca' ? 'text-accent' : 'text-foreground hover:text-accent'}`}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
      </svg>
    </a>

    <!-- Hamburger button (mobile only) -->
    <button
      id="mobile-menu-btn"
      class="md:hidden text-foreground p-1 rounded focus:outline-none focus:ring-2 focus:ring-accent"
      aria-label="Apri menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <!-- Hamburger icon -->
      <svg id="icon-hamburger" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <!-- Close icon -->
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
        fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        class="hidden">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </nav>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-border bg-background"
  >
    <ul class="flex flex-col px-6 py-4 gap-1">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class={`block py-3 text-base font-medium border-b border-border/50 transition-colors ${
              activePage === link.key
                ? 'text-accent'
                : 'text-foreground hover:text-accent'
            }`}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href={u('/cerca/')}
          class={`block py-3 text-base font-medium transition-colors ${
            activePage === 'cerca'
              ? 'text-accent'
              : 'text-foreground hover:text-accent'
          }`}
        >
          Cerca
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const btn  = document.getElementById('mobile-menu-btn')!
  const menu = document.getElementById('mobile-menu')!
  const iconH = document.getElementById('icon-hamburger')!
  const iconC = document.getElementById('icon-close')!

  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden')
    // open is true when we just added 'hidden' (= closing)
    btn.setAttribute('aria-expanded', open ? 'false' : 'true')
    iconH.classList.toggle('hidden', !open)
    iconC.classList.toggle('hidden', open)
  })

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!btn.contains(e.target as Node) && !menu.contains(e.target as Node)) {
      menu.classList.add('hidden')
      btn.setAttribute('aria-expanded', 'false')
      iconH.classList.remove('hidden')
      iconC.classList.add('hidden')
    }
  })
</script>
