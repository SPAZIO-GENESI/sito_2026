---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { u } from '../../utils/url'
import archivio from '../../data/archivio.json'
import artisti_data from '../../data/artisti.json'

export function getStaticPaths() {
  const eventiFiles = import.meta.glob('../../data/eventi/*.json', { eager: true }) as Record<string, any>
  const archivioIds = (archivio as any[]).map(e => e.id)

  return Object.entries(eventiFiles).map(([path, data]) => {
    const id = path.match(/([^/]+)\.json$/)?.[1] ?? ''
    const idx = archivioIds.indexOf(id)
    const prevId = idx > 0 ? archivioIds[idx - 1] : null
    const nextId = idx !== -1 && idx < archivioIds.length - 1 ? archivioIds[idx + 1] : null
    const prevInfo = prevId ? (archivio as any[]).find(e => e.id === prevId) ?? null : null
    const nextInfo = nextId ? (archivio as any[]).find(e => e.id === nextId) ?? null : null
    return { params: { id }, props: { evento: data.default ?? data, prevInfo, nextInfo } }
  })
}

const { evento, prevInfo, nextInfo } = Astro.props
const info = archivio.find(e => e.id === evento.id)
const bioMap = new Map(artisti_data.artisti.map((a: any) => [decodeURIComponent(a.nome).toLowerCase(), a.cartella]))

const creditLabels: Record<string, string> = {
  cura: 'A cura di',
  coordinamento: 'Coordinamento',
  grafiche: 'Grafiche',
  allestimento: 'Allestimento',
  grazie: 'Si ringrazia',
}

const creditOrder = ['cura', 'coordinamento', 'grafiche', 'allestimento', 'grazie']

const fotoBase = `/assets/eventi/${evento.id}/`

// Converte una data italiana ("13 Maggio 2026") in formato ISO 8601 per JSON-LD.
const MESI_ITALIANI: Record<string, string> = {
  gennaio: '01', febbraio: '02', marzo: '03', aprile: '04', maggio: '05', giugno: '06',
  luglio: '07', agosto: '08', settembre: '09', ottobre: '10', novembre: '11', dicembre: '12',
}
function dataItalianaToISO(data?: string): string | undefined {
  const m = data?.match(/^(\d{1,2})\s+([A-Za-zàèéìòù]+)\s+(\d{4})$/)
  if (!m) return undefined
  const mese = MESI_ITALIANI[m[2].toLowerCase()]
  if (!mese) return undefined
  return `${m[3]}-${mese}-${m[1].padStart(2, '0')}`
}

const startDate = dataItalianaToISO(info?.data)

const exhibitionSchema = info ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ExhibitionEvent',
  name: info.titolo,
  description: info.descrizione,
  ...(startDate ? { startDate } : {}),
  location: {
    '@type': 'ArtGallery',
    name: 'Spazio Genesi ETS',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Galleria Commerciale Via Roma, 215, primo piano',
      addressLocality: "L'Aquila",
      addressRegion: 'AQ',
      postalCode: '67100',
      addressCountry: 'IT',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Spazio Genesi ETS',
    url: 'https://spaziogenesi.org',
  },
  ...(evento.locandina ? { image: `https://spaziogenesi.org${u(evento.locandina)}` } : {}),
  ...(info.artiste && info.artiste.length > 0
    ? { performer: info.artiste.map((nome: string) => ({ '@type': 'Person', name: nome })) }
    : {}),
}) : undefined
---

<BaseLayout
  title={`${info?.titolo ?? evento.id} — Spazio Genesi ETS`}
  description={info?.descrizione ?? ''}
  ogImage={evento.locandina ? `https://spaziogenesi.org${u(evento.locandina)}` : undefined}
  schemaLD={exhibitionSchema}
  activePage="archivio"
>

  <!-- Hero: locandina -->
  <section class="bg-secondary border-b border-border relative">

    <!-- Freccia sinistra (evento precedente in archivio) -->
    {prevInfo && (
      <a
        href={u(`/archivio/${prevInfo.id}/`)}
        class="event-nav-arrow hidden lg:flex left-0"
        aria-label={`Mostra precedente: ${prevInfo.titolo}`}
        title={prevInfo.titolo}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m15 18-6-6 6-6"/>
        </svg>
        <span class="event-nav-label">{prevInfo.titolo}</span>
      </a>
    )}

    <!-- Freccia destra (evento successivo in archivio) -->
    {nextInfo && (
      <a
        href={u(`/archivio/${nextInfo.id}/`)}
        class="event-nav-arrow hidden lg:flex right-0"
        aria-label={`Mostra successiva: ${nextInfo.titolo}`}
        title={nextInfo.titolo}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m9 18 6-6-6-6"/>
        </svg>
        <span class="event-nav-label">{nextInfo.titolo}</span>
      </a>
    )}

    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-10 items-start">

        <!-- Locandina -->
        <div class="w-full max-w-xs mx-auto lg:mx-0 shrink-0">
          {evento.locandina
            ? <img
                src={u(evento.locandina)}
                alt={evento.locandina_alt ?? info?.titolo ?? ''}
                class="w-full rounded-lg shadow-lg object-contain"
                loading="eager"
              />
            : <div class="w-full aspect-[2/3] rounded-lg border border-border bg-muted flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                  class="text-muted-foreground/30" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>
                </svg>
              </div>
          }
        </div>

        <!-- Info -->
        <div>
          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
            {info?.tipo ?? 'Mostra'} — {info?.data ?? info?.anno}
          </p>
          <h1 class="text-foreground mb-4">{info?.titolo ?? evento.id}</h1>

          {info?.artiste && info.artiste.length > 0 && (
            <p class="text-lg text-muted-foreground mb-6">
              {info.artiste.map((nome: string, i: number) => {
                const cartella = bioMap.get(nome.toLowerCase())
                return (
                  <>
                    {i > 0 && <span> — </span>}
                    {cartella
                      ? <a href={u(`/biografie/${cartella}/`)} class="hover:text-accent transition-colors">{nome}</a>
                      : <span>{nome}</span>
                    }
                  </>
                )
              })}
            </p>
          )}

          {info?.tags && info.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-6">
              {info.tags.map((tag: string) => (
                <span class="px-2.5 py-1 text-xs bg-muted text-muted-foreground rounded-full border border-border">{tag}</span>
              ))}
            </div>
          )}

          <!-- Credits -->
          <dl class="space-y-1.5 text-sm">
            {creditOrder.map(key => {
              const items = (evento.credits as any)?.[key]
              if (!items || items.length === 0) return null
              return (
                <div class="flex flex-wrap gap-x-2">
                  <dt class="text-muted-foreground shrink-0">{creditLabels[key]}:</dt>
                  <dd class="text-foreground">
                    {items.map((p: any, i: number) => (
                      <>
                        {p.href
                          ? <a href={p.external ? p.href : u(p.href)} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener noreferrer' : undefined} class="hover:text-accent transition-colors">{p.nome}</a>
                          : <span>{p.nome}</span>
                        }
                        {i < items.length - 1 && <span>, </span>}
                      </>
                    ))}
                  </dd>
                </div>
              )
            })}
          </dl>

          <!-- GDC20 badge -->
          {evento.extra?.gdc20 && (
            <div class="mt-5">
              <a href={evento.extra.gdc20.url} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-3 py-1.5 text-xs border border-border rounded-lg text-muted-foreground hover:text-accent hover:border-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                {evento.extra.gdc20.label}
              </a>
            </div>
          )}

          <!-- Comunicato stampa PDF -->
          {info?.comunicato && (
            <div class="mt-5">
              <a href={u(info.comunicato)} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium border border-border rounded-lg text-muted-foreground hover:text-foreground transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                Comunicato stampa (PDF)
              </a>
            </div>
          )}

          <div class="mt-6">
            <a href={u('/archivio/')} class="text-sm text-muted-foreground hover:text-accent transition-colors">
              ← Archivio mostre
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Photo gallery -->
  {evento.reportage && evento.reportage.foto && evento.reportage.foto.length > 0 && (
    <section class="py-14 bg-background border-b border-border">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-foreground">Reportage fotografico</h2>
          {evento.reportage.fotografa && (
            <p class="text-sm text-muted-foreground">
              Foto di{' '}
              {evento.reportage.fotografa.href
                ? <a href={evento.reportage.fotografa.external ? evento.reportage.fotografa.href : u(evento.reportage.fotografa.href)} target={evento.reportage.fotografa.external ? '_blank' : undefined} rel={evento.reportage.fotografa.external ? 'noopener noreferrer' : undefined} class="hover:text-accent transition-colors">{evento.reportage.fotografa.nome}</a>
                : <span>{evento.reportage.fotografa.nome}</span>
              }
            </p>
          )}
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3" id="gallery-grid">
          {evento.reportage.foto.map((foto: { file: string; didascalia?: string }, i: number) => (
            <button
              class="gallery-thumb group relative overflow-hidden rounded-md aspect-[4/3] bg-muted focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              data-src={u(`${fotoBase}${foto.file}`)}
              data-caption={foto.didascalia ?? ''}
              data-index={i}
              aria-label={`Foto ${i + 1}${foto.didascalia ? ': ' + foto.didascalia : ''}`}
            >
              <img
                src={u(`${fotoBase}${foto.file}`)}
                alt={foto.didascalia ?? `Foto vernissage ${i + 1}`}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              {foto.didascalia && (
                <div class="absolute inset-x-0 bottom-0 bg-black/60 text-white text-xs px-2 py-1 leading-tight opacity-0 group-hover:opacity-100 transition-opacity">
                  {foto.didascalia}
                </div>
              )}
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Lightbox dialog -->
  <dialog id="lightbox" class="fixed inset-0 z-50 w-screen h-screen max-w-none max-h-none m-0 p-0 bg-transparent backdrop:bg-black/85 border-0 outline-none">
    <div class="flex flex-col items-center justify-center w-full h-full px-4 py-8" id="lightbox-inner">
      <button id="lb-close" aria-label="Chiudi" class="absolute top-4 right-4 text-white hover:opacity-70 z-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button id="lb-prev" aria-label="Foto precedente" class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-white hover:opacity-70 z-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button id="lb-next" aria-label="Foto successiva" class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-white hover:opacity-70 z-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <img id="lb-img" src="" alt="" class="max-h-[80vh] max-w-[90vw] object-contain rounded shadow-2xl" />
      <p id="lb-caption" class="mt-3 text-white/80 text-sm text-center max-w-lg"></p>
      <p id="lb-counter" class="mt-1 text-white/50 text-xs"></p>
    </div>
  </dialog>

  <!-- Foglio di sala -->
  {((evento.foglio_di_sala && evento.foglio_di_sala.length > 0) || evento.foglio_di_sala_pdf) && (
    <section class="py-14 bg-secondary border-b border-border">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <h2 class="text-foreground mb-8">Foglio di sala</h2>
        {evento.foglio_di_sala && evento.foglio_di_sala.length > 0 && (
          <div class="space-y-5 text-sm text-muted-foreground leading-relaxed">
            {evento.foglio_di_sala.map((para: string) => <p>{para}</p>)}
          </div>
        )}

        <!-- PDF foglio di sala -->
        <div class="mt-8">
          {evento.foglio_di_sala_pdf
            ? <a href={u(evento.foglio_di_sala_pdf)} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium border border-border rounded-lg text-muted-foreground hover:text-foreground transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                Foglio di sala (PDF)
              </a>
            : <button disabled
                class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium border border-border rounded-lg text-muted-foreground/40 cursor-not-allowed"
                title="Disponibile prossimamente">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
                Foglio di sala (PDF)
              </button>
          }
        </div>
      </div>
    </section>
  )}

  <!-- Comunicati stampa -->
  {evento.comunicati_stampa && evento.comunicati_stampa.length > 0 && (
    <section class="py-14 bg-background">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <h2 class="text-foreground mb-6">Rassegna stampa</h2>
        <ul class="space-y-3">
          {evento.comunicati_stampa.map((cs: { fonte: string; titolo: string; url: string }) => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 shrink-0 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
              <div>
                <span class="text-xs text-muted-foreground">{cs.fonte}</span>
                <br />
                <a href={cs.url} target="_blank" rel="noopener noreferrer"
                  class="text-sm text-accent hover:opacity-80 transition-opacity">
                  {cs.titolo}
                </a>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

</BaseLayout>

<style>
  .event-nav-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    color: var(--color-muted-foreground);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    transition: color 0.15s, background 0.15s, box-shadow 0.15s;
    text-decoration: none;
  }
  .event-nav-arrow:hover {
    color: var(--color-foreground);
    background: var(--color-muted);
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  }
  .event-nav-label {
    display: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: 0.4rem;
    padding: 0.3rem 0.6rem;
    font-size: 0.7rem;
    white-space: nowrap;
    max-width: 14rem;
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    color: var(--color-foreground);
    line-height: 1.4;
  }
  .event-nav-arrow.left-0 .event-nav-label  { left: 3rem; }
  .event-nav-arrow.right-0 .event-nav-label { right: 3rem; }
  .event-nav-arrow:hover .event-nav-label { display: block; }
</style>

<script type="module" src="/scripts/lightbox-archivio.js" is:inline></script>
