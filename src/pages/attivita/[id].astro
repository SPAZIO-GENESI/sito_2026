---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { u } from '../../utils/url'

export function getStaticPaths() {
  const attivitaFiles = import.meta.glob('../../data/attivita/*.json', { eager: true }) as Record<string, any>
  return Object.entries(attivitaFiles).map(([path, data]) => {
    const id = path.match(/([^/]+)\.json$/)?.[1] ?? ''
    return { params: { id }, props: { evento: data.default ?? data } }
  })
}

const { evento } = Astro.props

const fotoBase = `/assets/attivita/${evento.id}/`
---

<BaseLayout
  title={`${evento.titolo ?? evento.id} — Spazio Genesi ETS`}
  description={evento.descrizione ?? ''}
  ogImage={evento.locandina ? `https://spaziogenesi.org${u(evento.locandina)}` : undefined}
  activePage="attivita"
>

  <!-- Hero -->
  <section class="bg-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-12 lg:py-16">
      <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-10 items-start">

        <!-- Locandina -->
        <div class="w-full max-w-xs mx-auto lg:mx-0 shrink-0">
          {evento.locandina
            ? <img
                src={u(evento.locandina)}
                alt={evento.locandina_alt ?? evento.titolo ?? ''}
                class="w-full rounded-lg shadow-lg object-contain"
                loading="eager"
              />
            : <div class="w-full aspect-[2/3] rounded-lg border border-border bg-muted flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"
                  class="text-muted-foreground/30" aria-hidden="true">
                  <path d="M8 2v4"/><path d="M16 2v4"/>
                  <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
                </svg>
              </div>
          }
        </div>

        <!-- Info -->
        <div>
          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">
            {evento.tipo ?? 'Evento'} — {evento.data ?? evento.anno}
          </p>
          <h1 class="text-foreground mb-4">{evento.titolo ?? evento.id}</h1>

          {evento.descrizione && (
            <p class="text-lg text-muted-foreground mb-6" set:html={evento.descrizione} />
          )}

          {evento.tags && evento.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-6">
              {evento.tags.map((tag: string) => (
                <span class="px-2.5 py-1 text-xs bg-muted text-muted-foreground rounded-full border border-border">{tag}</span>
              ))}
            </div>
          )}

          <div class="mt-6">
            <a href={u('/attivita/')} class="text-sm text-muted-foreground hover:text-accent transition-colors">
              ← Attività
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Photo gallery -->
  {evento.reportage && evento.reportage.foto && evento.reportage.foto.length > 0 && (
    <section class="py-14 bg-background border-b border-border">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
        <div class="flex items-baseline justify-between mb-6">
          <h2 class="text-foreground">Reportage fotografico</h2>
          {evento.reportage.fotografa && (
            <p class="text-sm text-muted-foreground">
              Foto di{' '}
              {evento.reportage.fotografa.href
                ? <a href={evento.reportage.fotografa.href} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">{evento.reportage.fotografa.nome}</a>
                : <span>{evento.reportage.fotografa.nome}</span>
              }
            </p>
          )}
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-3" id="gallery-grid">
          {evento.reportage.foto.map((foto: { file: string; didascalia?: string }, i: number) => (
            <button
              class="gallery-thumb group relative overflow-hidden rounded-md aspect-[4/3] bg-muted focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              data-src={u(`${fotoBase}${foto.file}`)}
              data-caption={foto.didascalia ?? ''}
              data-index={i}
              aria-label={`Foto ${i + 1}${foto.didascalia ? ': ' + foto.didascalia : ''}`}
            >
              <img
                src={u(`${fotoBase}${foto.file}`)}
                alt={foto.didascalia ?? `Foto ${i + 1}`}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
              {foto.didascalia && (
                <div class="absolute inset-x-0 bottom-0 bg-black/60 text-white text-xs px-2 py-1 leading-tight opacity-0 group-hover:opacity-100 transition-opacity">
                  {foto.didascalia}
                </div>
              )}
            </button>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Lightbox dialog -->
  <dialog id="lightbox" class="fixed inset-0 z-50 w-screen h-screen max-w-none max-h-none m-0 p-0 bg-transparent backdrop:bg-black/85 border-0 outline-none">
    <div class="flex flex-col items-center justify-center w-full h-full px-4 py-8">
      <button id="lb-close" aria-label="Chiudi" class="absolute top-4 right-4 text-white hover:opacity-70 z-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
      <button id="lb-prev" aria-label="Foto precedente" class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 text-white hover:opacity-70 z-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button id="lb-next" aria-label="Foto successiva" class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 text-white hover:opacity-70 z-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <img id="lb-img" src="" alt="" class="max-h-[80vh] max-w-[90vw] object-contain rounded shadow-2xl" />
      <p id="lb-caption" class="mt-3 text-white/80 text-sm text-center max-w-lg"></p>
      <p id="lb-counter" class="mt-1 text-white/50 text-xs"></p>
    </div>
  </dialog>

  <!-- Note -->
  {evento.note && (
    <section class="py-14 bg-secondary border-b border-border">
      <div class="max-w-3xl mx-auto px-6 lg:px-8">
        <div class="space-y-5 text-sm text-muted-foreground leading-relaxed">
          {evento.note.map((para: string) => <p>{para}</p>)}
        </div>
      </div>
    </section>
  )}

</BaseLayout>

<script type="module" src="/scripts/lightbox-attivita.js" is:inline></script>
