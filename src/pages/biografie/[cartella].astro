---
import BaseLayout from '../../layouts/BaseLayout.astro'
import data from '../../data/artisti.json'
import archivio_data from '../../data/archivio.json'
import { flattenImmagini, extractAbstract } from '../../types'
import type { Artista } from '../../types'
import { u } from '../../utils/url'

type EventoArchivio = { id: string; titolo: string; data?: string; anno: number; artiste: string[]; curatrice?: string }

export function getStaticPaths() {
  return (data.artisti as Artista[]).map(artista => ({
    params: { cartella: artista.cartella },
    props: { artista },
  }))
}

interface Props { artista: Artista }
const { artista } = Astro.props

const nomeDecoded = decodeURIComponent(artista.nome)
const immagini = flattenImmagini(artista.img)
const tutteImg = immagini.filter(i => i.img)
const abstract = extractAbstract(artista.bio, 300)

// URL media: assoluto (R2) usato così com'è, altrimenti file locale in /public
const imgSrc = (v: string) => (/^https?:\/\//.test(v) ? v : u(`/biografie/${artista.cartella}/${v}`))
const isVideo = (v: string) => /\.(mp4|webm|mov|m4v)$/i.test(v)
// il ritratto/OG è sempre un'immagine (mai un video)
const primaImg = tutteImg.find(i => !isVideo(i.img))

const mioNome = nomeDecoded.toLowerCase()
const mostrePartecipate = (archivio_data as EventoArchivio[]).filter(ev =>
  ev.artiste.some(a => a.toLowerCase() === mioNome) ||
  (ev.curatrice != null && ev.curatrice.toLowerCase() === mioNome)
)

const ogImageUrl = primaImg
  ? `https://ogcdn.net/e4b8c678-7bd5-445d-ba03-bfaad510c686/v4/${encodeURIComponent('Biografia ' + nomeDecoded)}/${encodeURIComponent('Artista Spazio Genesi')}/${encodeURIComponent('https://spaziogenesi.org/biografie/' + artista.cartella + '/' + primaImg.img)}/og.png`
  : undefined

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: nomeDecoded,
  description: abstract,
  ...(primaImg ? { image: `https://spaziogenesi.org/biografie/${artista.cartella}/${primaImg.img}` } : {}),
  url: `https://spaziogenesi.org/biografie/${artista.cartella}/`,
  affiliation: {
    '@type': 'Organization',
    name: 'Spazio Genesi ETS',
    url: 'https://spaziogenesi.org',
  },
})
---
<BaseLayout
  title={`${nomeDecoded} — Spazio Genesi`}
  description={abstract}
  ogImage={ogImageUrl}
  canonical={`https://spaziogenesi.org/biografie/${artista.cartella}/`}
  schemaLD={personSchema}
  activePage="biografie"
>
  <!-- Back navigation -->
  <div class="bg-background border-b border-border" data-no-print>
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-4">
      <a href={u('/biografie/')} class="inline-flex items-center gap-2 text-accent font-semibold hover:opacity-80 transition-opacity">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        </svg>
        Tutte le biografie
      </a>
    </div>
  </div>

  <!-- ① PROFILO: immagine + scheda -->
  <section class="py-12 lg:py-20 bg-background">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-12">

        <!-- Colonna sinistra: ritratto -->
        <div class="lg:col-span-1">
          {primaImg ? (
            <img
              id="portrait"
              src={imgSrc(primaImg.img)}
              alt={nomeDecoded}
              class="w-full rounded-lg shadow-lg object-cover aspect-square"
            />
          ) : (
            <div id="portrait" class="w-full aspect-square rounded-lg bg-muted flex items-center justify-center text-6xl font-display text-muted-foreground">
              {nomeDecoded.charAt(0)}
            </div>
          )}
        </div>

        <!-- Colonna destra: nome + abstract + link -->
        <div class="lg:col-span-2 flex flex-col justify-start">
          <h1 class="text-foreground mb-4">{nomeDecoded}</h1>

          <p id="bio-abstract" class="text-muted-foreground text-base leading-relaxed mb-6">
            {abstract}
          </p>

          {mostrePartecipate.length > 0 && (
            <div class="mb-8">
              <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">Mostre a Spazio Genesi</p>
              <ul class="space-y-1">
                {mostrePartecipate.map(ev => {
                  const comeCuratrice = ev.curatrice != null && ev.curatrice.toLowerCase() === mioNome
                  return (
                    <li class="flex items-baseline gap-2 text-sm">
                      <a href={u(`/archivio/#${ev.id}`)} class="text-accent hover:opacity-80 transition-opacity font-medium">
                        {ev.titolo}
                      </a>
                      <span class="text-muted-foreground text-xs shrink-0">
                        {ev.data ?? ev.anno}{comeCuratrice && ' — cura'}
                      </span>
                    </li>
                  )
                })}
              </ul>
            </div>
          )}

          <!-- Header visibile solo in stampa -->
          <div class="print-only-header">
            <p class="print-sg-label">Spazio Genesi ETS — spaziogenesi.org</p>
          </div>

          <div class="space-y-2 text-sm">
            {artista.IG && (
              <a id="lnk-ig" href={`https://www.instagram.com/${artista.IG}`} target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-2 text-accent hover:opacity-80 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
                <span data-igtext>Instagram @{artista.IG}</span>
              </a>
            )}
            {artista.social && (
              <a id="lnk-social" href={artista.social} target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-2 text-accent hover:opacity-80 transition-opacity break-all">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                  <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
                </svg>
                <span data-soctext>{artista.social}</span>
              </a>
            )}
            {artista.portfolio && (
              <a id="lnk-portfolio" href={u(`/biografie/${artista.cartella}/${artista.portfolio}`)} target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-2 text-accent hover:opacity-80 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                  <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                </svg>
                Portfolio PDF
              </a>
            )}
          </div>

          <!-- Pulsante portfolio -->
          <div class="mt-6 pt-4 border-t border-border" data-no-print>
            <button
              id="btn-print"
              class="inline-flex items-center gap-2 text-sm font-medium text-foreground border border-border rounded px-4 py-2 hover:bg-muted transition-colors cursor-pointer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <polyline points="7 10 12 15 17 10"/>
                <line x1="12" y1="15" x2="12" y2="3"/>
              </svg>
              Scarica come Portfolio
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ② BIOGRAFIA COMPLETA -->
  <section class="py-16 lg:py-24 bg-secondary border-t border-b border-border">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <h2 class="text-foreground mb-8">Biografia</h2>
      <div id="bio-full" class="regdiv text-justify">
        <Fragment set:html={artista.bio} />
      </div>
    </div>
  </section>

  <!-- ③ OPERE (tutte le immagini, incluso il ritratto) -->
  <section id="opere-sec" class={`py-16 lg:py-24 bg-background ${tutteImg.length > 0 ? '' : 'hidden'}`}>
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-foreground mb-12">Opere</h2>
      <div id="opere-grid" class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {tutteImg.map(img => (
          <figure class="rounded-lg overflow-hidden shadow-lg">
            {isVideo(img.img) ? (
              <video src={imgSrc(img.img)} controls preload="metadata" class="w-full bg-black" />
            ) : (
              <img
                src={imgSrc(img.img)}
                alt={img.des || nomeDecoded}
                class="w-full object-cover"
                loading="lazy"
              />
            )}
            {(img.des || img.deslunga) && (
              <figcaption class="p-4 bg-card">
                {img.des && <p class="text-sm font-medium text-foreground mb-1">{img.des}</p>}
                {img.deslunga && (
                  <>
                    <div class="opera-desc regdiv text-xs text-muted-foreground">
                      <Fragment set:html={img.deslunga} />
                    </div>
                    <button type="button" class="opera-toggle">Leggi tutto ▾</button>
                  </>
                )}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="bg-background border-t border-border py-2" data-no-print>
    <div class="max-w-7xl mx-auto flex items-center">
      <span class="shrink-0 bg-red-600 text-white text-xs font-semibold px-3 py-2 mr-3">News</span>
      <div class="overflow-hidden text-sm text-muted-foreground">
        <marquee behavior="scroll" direction="left">
          laboratorio permanente di interazione — noi che...voi che...presente e futuro — autogestito —
          riservato ad iscritt* ABAQ + Erasmus — multi manifesto — tutte le tecniche — rotazione espositiva —
          archivio donazioni — caffè letterario — conviviale — assemblea aperta — spazio safe
        </marquee>
      </div>
    </div>
  </div>
</BaseLayout>

<script src="/scripts/bio-live-update.js" is:inline></script>
<script src="/scripts/bio-page-extras.js" is:inline></script>

<style>
  .print-only-header { display: none; }

  @media print {
    @page { margin: 1.8cm 2cm; size: A4 portrait; }

    /* Nascondi navigazione, header, footer, widget */
    header, footer,
    [data-no-print],
    #tawk-bubble-container,
    #tawkIframe,
    .cookie-banner { display: none !important; }

    /* Rimuovi sfondi e bordi per la stampa */
    body, section { background: white !important; }
    .border-t, .border-b, .border-border { border-color: #e5e5e5 !important; }

    /* Layout griglia: mantieni affiancamento foto/scheda */
    .grid { display: grid !important; }

    /* Immagini */
    img { max-width: 100% !important; break-inside: avoid; }

    /* Sezioni su pagine separate se troppo lunghe */
    section { break-inside: avoid; }

    /* Opere: una sola colonna in stampa per leggibilità */
    .grid.grid-cols-1.md\:grid-cols-2 { grid-template-columns: 1fr 1fr !important; }

    /* Header branding visibile solo in stampa */
    .print-only-header { display: block !important; margin-bottom: 0.8rem; }
    .print-sg-label {
      font-size: 9pt;
      color: #888;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-bottom: 1px solid #ddd;
      padding-bottom: 4px;
      margin-bottom: 0;
    }

    /* Link: non mostrare URL dopo il testo */
    a::after { content: none !important; }

    /* Riduci padding verticali per risparmiare spazio */
    .py-12, .py-16, .py-20, .py-24,
    .lg\:py-20, .lg\:py-24 { padding-top: 1.2rem !important; padding-bottom: 1.2rem !important; }
  }
</style>
