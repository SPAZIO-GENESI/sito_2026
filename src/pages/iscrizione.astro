---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout
  title="Iscrizione e Donazioni — Spazio Genesi"
  description="Iscriviti a Spazio Genesi ETS come volontario o socia, oppure sostieni le nostre attività con una donazione."
  activePage="iscrizione"
>
  <section class="py-16 lg:py-20 bg-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h1 class="text-foreground mb-4">Iscrizione e Donazioni</h1>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Sostieni Spazio Genesi ETS diventando socia, volontaria, o contribuendo con una donazione libera.
        Ogni forma di partecipazione aiuta a mantenere vivo uno spazio autogestito e aperto alla comunità.
      </p>
    </div>
  </section>

  <section class="py-16 bg-background">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-start">

        <!-- Card: Quota VOLONTARIO -->
        <div class="border border-border rounded-xl p-7 bg-background flex flex-col gap-5">
          <div>
            <h2 class="text-lg font-semibold text-foreground mb-2">Quota Volontario</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Iscrizione come <strong class="text-foreground">VOLONTARIO</strong> per 365 giorni.
              Accesso alle fasi di installazione con copertura assicurativa.
            </p>
          </div>
          <div id="paypal-container-V7NLWNW8BK6D2"></div>
        </div>

        <!-- Card: Quota SOCIA -->
        <div class="border border-border rounded-xl p-7 bg-background flex flex-col gap-5">
          <div>
            <h2 class="text-lg font-semibold text-foreground mb-2">Quota Socia</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Iscrizione mensile libera come <strong class="text-foreground">SOCIA</strong>.
              Partecipazione alle attività e agli eventi di Spazio Genesi.
            </p>
          </div>
          <div id="paypal-container-5EVEGBYTDSAJG"></div>
        </div>

        <!-- Card: Donazione (evidenziata) -->
        <div class="border-2 border-accent rounded-xl p-7 bg-background flex flex-col gap-5">
          <div>
            <h2 class="text-lg font-semibold text-foreground mb-2">Donazione libera</h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Sostieni Spazio Genesi con una <strong class="text-foreground">donazione libera</strong>.
              Ogni contributo aiuta a coprire le spese operative dello spazio.
            </p>
          </div>
          <div id="paypal-container-2MY36H66BSN4W"></div>
        </div>

      </div>

      <!-- Abbonamento mensile per un anno -->
      <div class="mt-10 border border-border rounded-xl p-7 bg-background">
        <div class="flex flex-col md:flex-row md:items-start gap-6">
          <div class="flex-1">
            <h2 class="text-lg font-semibold text-foreground mb-2">Abbonamento mensile per un anno</h2>
            <p class="text-sm text-muted-foreground leading-relaxed max-w-xl">
              Un'unica quota annuale per sostenere le attività e partecipare ai progetti di Spazio Genesi.
              Oltre ai vantaggi trimestrali avrai accesso a licenze software e risorse web di pubblicazione
              statica con dominio di terzo livello (es. <span class="font-mono text-xs">nomeartista.spaziogenesi.org</span>),
              eleggibilità a ruoli operativi e CDA.
            </p>
          </div>
          <div class="shrink-0 w-full md:w-64">
            <div id="paypal-button-container-P-7ML05505JA818620MNG6B4LA"></div>
          </div>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<!-- Guard: revert overflow:hidden that PayPal SDKs may inject on html/body (breaks sticky header) -->
<script is:inline>
  (function() {
    var targets = [document.documentElement, document.body];
    function restoreOverflow(el) {
      if (el && el.style && el.style.overflow === 'hidden') {
        el.style.overflow = '';
      }
    }
    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(m) {
        if (m.type === 'attributes' && m.attributeName === 'style') {
          restoreOverflow(m.target);
        }
      });
    });
    targets.forEach(function(t) {
      observer.observe(t, { attributes: true, attributeFilter: ['style', 'class'] });
    });
  })();
</script>

<!-- PayPal SDK 1: hosted-buttons (Volontario, Socia, Donazione) -->
<script
  src="https://www.paypal.com/sdk/js?client-id=BAAWaqUltEyNiREyqCFGtH46W-x7TOP9Rc26ILViUvyJWFNw4U91zwyPWw8lUimPNBBOXc9fH9mUocMFxA&components=hosted-buttons&disable-funding=venmo&currency=EUR"
  data-sdk-integration-source="button-factory"
></script>
<script is:inline>
  paypal.HostedButtons({ hostedButtonId: 'V7NLWNW8BK6D2' }).render('#paypal-container-V7NLWNW8BK6D2');
  paypal.HostedButtons({ hostedButtonId: '5EVEGBYTDSAJG' }).render('#paypal-container-5EVEGBYTDSAJG');
  paypal.HostedButtons({ hostedButtonId: '2MY36H66BSN4W' }).render('#paypal-container-2MY36H66BSN4W');
</script>

<!-- PayPal SDK 2: subscription (Abbonamento mensile) — caricato dopo che i bottoni hosted sono già renderizzati -->
<script
  src="https://www.paypal.com/sdk/js?client-id=Ab6joAWjiJDrrrqzYb0gzg5uDBCtCI0Td5NXZealzworAbewh__9rgxpuKHzRCRo9xSiKhME-hOIAFRg&vault=true&intent=subscription"
  data-sdk-integration-source="button-factory"
></script>
<script is:inline>
  paypal.Buttons({
    style: { shape: 'rect', color: 'gold', layout: 'vertical', label: 'subscribe' },
    createSubscription: function(data, actions) {
      return actions.subscription.create({ plan_id: 'P-7ML05505JA818620MNG6B4LA' });
    },
    onApprove: function(data) {
      window.location.href = window.location.pathname + '?abbonamento=ok';
    }
  }).render('#paypal-button-container-P-7ML05505JA818620MNG6B4LA');
</script>
