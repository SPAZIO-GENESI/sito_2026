---
import BaseLayout from '../layouts/BaseLayout.astro'
import eventi from '../data/archivio.json'
import { u } from '../utils/url'
const grafoUrl = u('/grafo/')

const anni = [...new Set(eventi.map(e => e.anno))].sort((a, b) => b - a)
const tipi = [...new Set(eventi.map(e => e.tipo))]
const tags = [...new Set(eventi.flatMap(e => e.tags))].sort()
---
<BaseLayout
  title="Archivio — Spazio Genesi"
  description="Archivio delle mostre e degli eventi di Spazio Genesi ETS, Accademia di Belle Arti dell'Aquila."
  activePage="archivio"
>
  <!-- Header -->
  <section class="py-16 lg:py-20 bg-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h1 class="text-foreground mb-4">Archivio</h1>
      <p class="text-lg text-muted-foreground max-w-2xl mb-8">
        Mostre ed eventi di Spazio Genesi ETS dal 2024 ad oggi.
      </p>

      <!-- Filtri -->
      <div class="space-y-4">
        <div>
          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">Per anno</p>
          <div class="flex flex-wrap gap-2">
            {anni.map(a => (
              <button class="filter-btn px-4 py-1.5 rounded-full border border-border text-sm font-medium transition-colors text-foreground hover:bg-muted"
                data-group="anno" data-value={String(a)}>
                {a}
              </button>
            ))}
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">Per tipo</p>
          <div class="flex flex-wrap gap-2">
            {tipi.map(t => (
              <button class="filter-btn px-4 py-1.5 rounded-full border border-border text-sm font-medium transition-colors text-foreground hover:bg-muted"
                data-group="tipo" data-value={t}>
                {t}
              </button>
            ))}
          </div>
        </div>
        <div>
          <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-2">Per tag</p>
          <div class="flex flex-wrap gap-2">
            {tags.map(t => (
              <button class="filter-btn px-3 py-1 rounded-full bg-muted text-muted-foreground text-xs font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
                data-group="tag" data-value={t}>
                {t}
              </button>
            ))}
          </div>
        </div>
        <button id="reset-filters" class="text-xs text-accent hover:opacity-80 transition-opacity hidden">
          ✕ Azzera filtri
        </button>
      </div>
    </div>
  </section>

  <!-- Lista eventi -->
  <section class="py-16 lg:py-24 bg-background">

    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
        <p id="count-label" class="text-sm text-muted-foreground">{eventi.length} eventi</p>
        <a href={grafoUrl} class="inline-flex items-center gap-2 text-sm font-medium text-accent hover:opacity-80 transition-opacity">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="5" cy="12" r="2"/><circle cx="19" cy="5" r="2"/><circle cx="19" cy="19" r="2"/>
            <path d="M5.45 10.89 19 6.93"/><path d="M5.45 13.11 19 17.07"/>
          </svg>
          Visualizza grafo semantico
        </a>
      </div>

      <div id="archivio-list" class="space-y-4">
        {eventi.map(ev => (
          <div
            class="archivio-item border border-border rounded-lg p-6 hover:shadow-md transition-shadow"
            data-anno={String(ev.anno)}
            data-tipo={ev.tipo}
            data-tags={ev.tags.join(' ')}
          >
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
              <!-- Contenuto -->
              <div class="flex-1">
                <div class="flex items-start gap-3 mb-2">
                  <!-- Icona tipo -->
                  {ev.tipo === 'Mostra' ? (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="text-accent shrink-0 mt-0.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/>
                    </svg>
                  ) : (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      class="text-accent shrink-0 mt-0.5" aria-hidden="true">
                      <path d="M8 2v4"/><path d="M16 2v4"/>
                      <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
                    </svg>
                  )}
                  <div>
                    <h3 class="text-foreground font-semibold">{ev.titolo}</h3>
                    <p class="text-muted-foreground text-sm">{ev.descrizione}</p>
                  </div>
                </div>

                <!-- Metadati -->
                <div class="flex flex-wrap items-center gap-4 text-sm text-muted-foreground mt-3">
                  <div class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M8 2v4"/><path d="M16 2v4"/>
                      <rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
                    </svg>
                    <span>{ev.data ?? ev.anno}</span>
                  </div>
                  <div class="flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"/>
                      <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"/>
                    </svg>
                    <span class="font-medium">{ev.tipo}</span>
                  </div>
                  {ev.artiste.length > 0 && (
                    <span class="text-muted-foreground">{ev.artiste.join(', ')}</span>
                  )}
                  {ev.curatrice && (
                    <span class="italic text-muted-foreground">cura: {ev.curatrice}</span>
                  )}
                </div>

                <!-- Tag -->
                {ev.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    {ev.tags.map(tag => (
                      <span class="text-xs px-2 py-0.5 bg-muted text-muted-foreground rounded-full">{tag}</span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Pulsante download -->
              {ev.comunicato && (
                <a
                  href={u(ev.comunicato)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 bg-accent text-accent-foreground px-5 py-2.5 rounded-lg text-sm font-semibold hover:opacity-90 transition-opacity shrink-0 self-start"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <path d="m7 10 5 5 5-5"/>
                  </svg>
                  Comunicato
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <p id="no-results" class="hidden text-center text-muted-foreground py-12">
        Nessun evento corrisponde ai filtri selezionati.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const items = document.querySelectorAll<HTMLElement>('.archivio-item')
  const countLabel = document.getElementById('count-label')!
  const noResults = document.getElementById('no-results')!
  const resetBtn = document.getElementById('reset-filters')!

  const active: Record<string, Set<string>> = { anno: new Set(), tipo: new Set(), tag: new Set() }

  function applyFilters() {
    let visible = 0
    items.forEach(item => {
      const annoOk = !active.anno.size || active.anno.has(item.dataset.anno!)
      const tipoOk = !active.tipo.size || active.tipo.has(item.dataset.tipo!)
      const tagsOk = !active.tag.size || [...active.tag].some(t => (item.dataset.tags ?? '').includes(t))
      const show = annoOk && tipoOk && tagsOk
      item.style.display = show ? '' : 'none'
      if (show) visible++
    })
    countLabel.textContent = `${visible} event${visible === 1 ? 'o' : 'i'}`
    noResults.classList.toggle('hidden', visible > 0)
    const hasFilters = Object.values(active).some(s => s.size > 0)
    resetBtn.classList.toggle('hidden', !hasFilters)
  }

  document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const group = btn.dataset.group!
      const value = btn.dataset.value!
      if (active[group].has(value)) {
        active[group].delete(value)
        btn.classList.remove('bg-accent', 'text-accent-foreground', 'border-accent')
        btn.classList.add('text-foreground')
      } else {
        active[group].add(value)
        btn.classList.add('bg-accent', 'text-accent-foreground', 'border-accent')
        btn.classList.remove('text-foreground', 'text-muted-foreground')
      }
      applyFilters()
    })
  })

  resetBtn.addEventListener('click', () => {
    Object.values(active).forEach(s => s.clear())
    document.querySelectorAll<HTMLButtonElement>('.filter-btn').forEach(btn => {
      btn.classList.remove('bg-accent', 'text-accent-foreground', 'border-accent')
      if (btn.dataset.group === 'tag') {
        btn.classList.add('text-muted-foreground')
      } else {
        btn.classList.add('text-foreground')
      }
    })
    applyFilters()
  })
</script>
