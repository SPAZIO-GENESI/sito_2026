---
import BaseLayout from '../../layouts/BaseLayout.astro'
---
<BaseLayout
  title="Admin biografie — Spazio Genesi"
  description="Gestione schede artisti (riservato)."
  noindex={true}
  activePage=""
>
  <section class="py-16 lg:py-20 bg-secondary border-b border-border">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <p class="text-xs font-semibold text-accent uppercase tracking-[0.3em] mb-4">Admin</p>
      <h1 class="text-foreground mb-4">Gestione schede artisti</h1>

      <div id="login-box">
        <div id="gbtn"></div>
        <p id="login-hint" class="text-sm text-muted-foreground mt-4"></p>
      </div>

      <div id="panel" class="hidden">
        <div class="flex items-center justify-between gap-4 flex-wrap mb-6">
          <p class="text-sm text-muted-foreground">Admin: <b id="acct" class="text-foreground"></b></p>
          <div class="flex gap-3">
            <button id="new" type="button" class="bg-accent text-accent-foreground px-4 py-2 rounded-lg text-sm font-semibold">+ Nuova scheda</button>
            <button id="logout" type="button" class="text-sm text-accent underline">Esci</button>
          </div>
        </div>

        <div class="overflow-x-auto rounded-lg border border-border">
          <table class="w-full text-sm">
            <thead class="bg-secondary border-b border-border">
              <tr>
                <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-foreground">Cartella</th>
                <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-foreground">Nome</th>
                <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-foreground">Email</th>
                <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-foreground">Ultima modifica</th>
                <th class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-foreground">Stato</th>
                <th class="px-3 py-2"></th>
              </tr>
            </thead>
            <tbody id="tbody"></tbody>
          </table>
        </div>
        <p id="status" class="text-sm mt-4" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <!-- Editor scheda (admin) -->
  <section id="form-sec" class="hidden py-12 bg-background">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <h2 id="form-title" class="text-foreground mb-6">Scheda</h2>
      <form id="form" class="space-y-5">
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block"><span class="text-sm font-semibold text-foreground">Cartella (slug)</span>
            <input id="a-cartella" type="text" class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" /></label>
          <label class="block"><span class="text-sm font-semibold text-foreground">Email (login Google)</span>
            <input id="a-email" type="email" class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" /></label>
        </div>
        <label class="block"><span class="text-sm font-semibold text-foreground">Nome</span>
          <input id="a-nome" type="text" class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" /></label>
        <div><span class="text-sm font-semibold text-foreground">Biografia</span>
          <div class="mt-1 border border-border rounded-lg overflow-hidden bg-background">
            <div id="a-bio-tb" class="flex flex-wrap gap-1 p-2 border-b border-border bg-secondary text-sm">
              <button type="button" data-cmd="bold" class="px-2.5 py-1 rounded hover:bg-muted font-bold" title="Grassetto">G</button>
              <button type="button" data-cmd="italic" class="px-2.5 py-1 rounded hover:bg-muted italic" title="Corsivo">C</button>
              <button type="button" data-cmd="insertUnorderedList" class="px-2.5 py-1 rounded hover:bg-muted" title="Elenco puntato">• elenco</button>
              <button type="button" data-cmd="createLink" class="px-2.5 py-1 rounded hover:bg-muted" title="Inserisci link">🔗 link</button>
              <button type="button" data-cmd="unlink" class="px-2.5 py-1 rounded hover:bg-muted" title="Togli link">✕ link</button>
              <button type="button" data-cmd="insertHorizontalRule" class="px-2.5 py-1 rounded hover:bg-muted" title="Linea separatrice">— linea</button>
            </div>
            <div id="a-bio" contenteditable="true" class="px-4 py-3 min-h-[160px] text-foreground leading-relaxed focus:outline-none"></div>
          </div>
        </div>
        <div class="grid sm:grid-cols-3 gap-4">
          <label class="block"><span class="text-sm font-semibold text-foreground">Instagram</span>
            <input id="a-ig" type="text" class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" /></label>
          <label class="block"><span class="text-sm font-semibold text-foreground">Social (URL)</span>
            <input id="a-social" type="url" class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" /></label>
          <label class="block"><span class="text-sm font-semibold text-foreground">Portfolio</span>
            <input id="a-portfolio" type="text" class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" /></label>
        </div>
        <div class="flex items-center gap-4">
          <button type="submit" class="bg-accent text-accent-foreground px-6 py-3 rounded-lg font-semibold">Salva</button>
          <button type="button" id="cancel" class="text-sm text-accent underline">Annulla</button>
          <p id="form-status" class="text-sm" aria-live="polite"></p>
        </div>
      </form>

      <div id="admin-foto" class="hidden pt-6 mt-6 border-t border-border">
        <h3 class="text-foreground font-semibold mb-1">Foto</h3>
        <p class="text-xs text-muted-foreground mb-4">
          Puoi caricare <b>foto</b> (JPG, PNG, WebP — max <b>8 MB</b>) <b>e video</b> (MP4 o WebM — max <b>64 MB</b>; si vedono con play e audio).
          La <b>prima</b> immagine è il ritratto. L'ultimo caricato compare per primo.
        </p>
        <div id="afoto-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4"></div>
        <div class="flex flex-wrap items-center gap-3">
          <input id="afoto-file" type="file" accept="image/*,video/mp4,video/webm" class="text-sm" />
          <input id="afoto-des" type="text" placeholder="didascalia" class="px-3 py-2 border border-border rounded-lg bg-background text-foreground text-sm flex-1 min-w-[160px]" />
          <button type="button" id="afoto-up" class="bg-accent text-accent-foreground px-4 py-2 rounded-lg text-sm font-semibold">Carica</button>
          <span id="afoto-status" class="text-xs"></span>
        </div>

        <div id="acap" class="hidden mt-4 p-4 border border-border rounded-lg bg-secondary">
          <p class="text-sm font-semibold text-foreground mb-2">Descrizione della foto</p>
          <input id="acap-des" type="text" placeholder="didascalia breve" class="w-full px-3 py-2 border border-border rounded-lg bg-background text-foreground text-sm mb-3" />
          <span class="block text-xs text-muted-foreground mb-1">Descrizione estesa (con formattazione):</span>
          <div class="border border-border rounded-lg overflow-hidden bg-background">
            <div id="acap-tb" class="flex flex-wrap gap-1 p-2 border-b border-border bg-secondary text-sm">
              <button type="button" data-cmd="bold" class="px-2.5 py-1 rounded hover:bg-muted font-bold">G</button>
              <button type="button" data-cmd="italic" class="px-2.5 py-1 rounded hover:bg-muted italic">C</button>
              <button type="button" data-cmd="insertUnorderedList" class="px-2.5 py-1 rounded hover:bg-muted">• elenco</button>
              <button type="button" data-cmd="createLink" class="px-2.5 py-1 rounded hover:bg-muted">🔗 link</button>
              <button type="button" data-cmd="unlink" class="px-2.5 py-1 rounded hover:bg-muted">✕ link</button>
              <button type="button" data-cmd="insertHorizontalRule" class="px-2.5 py-1 rounded hover:bg-muted">— linea</button>
            </div>
            <div id="acap-long" contenteditable="true" class="px-4 py-3 min-h-[120px] text-foreground leading-relaxed focus:outline-none"></div>
          </div>
          <div class="flex items-center gap-3 mt-3">
            <button type="button" id="acap-save" class="bg-accent text-accent-foreground px-4 py-2 rounded-lg text-sm font-semibold">Salva descrizione</button>
            <button type="button" id="acap-cancel" class="text-sm text-accent underline">Annulla</button>
            <span id="acap-status" class="text-xs"></span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline src="/visual-editor.js"></script>
<script is:inline src="https://accounts.google.com/gsi/client" async></script>
<script src="/scripts/area-artisti-admin.js" is:inline></script>
