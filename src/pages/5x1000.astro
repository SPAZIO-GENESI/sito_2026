---
import BaseLayout from '../layouts/BaseLayout.astro'
import { u } from '../utils/url'

const CF = '96602450585'

const steps = [
  ['Apri la tua dichiarazione', 'Modello 730, Modello Redditi PF, oppure la scheda allegata alla Certificazione Unica (CU) se non sei tenuto a dichiarare.'],
  ['Firma nel riquadro giusto', 'Nella sezione “Scelta per la destinazione del 5×1000”, firma nel riquadro “Sostegno degli enti del Terzo Settore iscritti nel RUNTS”.'],
  ['Scrivi il nostro codice fiscale', `Sotto la firma, indica il codice fiscale di Spazio Genesi ETS: ${CF}.`],
]

const faq = [
  ['Mi costa qualcosa?', 'No. Il 5×1000 è una quota dell’IRPEF che lo Stato comunque trattiene: decidi solo a chi destinarla. Non aumenta le tasse e non riduce un eventuale rimborso.'],
  ['È alternativo all’8×1000?', 'No. 5×1000 e 8×1000 sono scelte distinte e indipendenti: puoi fare entrambe nella stessa dichiarazione.'],
  ['Non presento la dichiarazione, posso comunque destinarlo?', 'Sì. Usa la scheda allegata alla CU: compilala, chiudila in busta e consegnala gratuitamente a un CAF, a un professionista abilitato o a un ufficio postale.'],
]
---
<BaseLayout
  title="5×1000 a Spazio Genesi ETS — CF 96602450585 | Sostienici gratis"
  description="Destina il tuo 5×1000 a Spazio Genesi ETS (CF 96602450585): non ti costa nulla e sostiene l'intera attività associativa — spazio espositivo, mostre, workshop e i servizi gratuiti come l'attestazione delle opere digitali. Ente del Terzo Settore iscritto al RUNTS."
  ogImage="https://spaziogenesi.org/assets/og-5x1000.png"
  activePage=""
>

  <!-- Hero -->
  <section class="py-16 lg:py-24 bg-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <p class="text-xs font-semibold text-accent uppercase tracking-[0.3em] mb-4">
        Sostienici · 5×1000
      </p>
      <h1 class="text-foreground mb-5">Il tuo 5×1000 non ti costa nulla.<br>A noi cambia tutto.</h1>
      <p class="text-lg text-muted-foreground max-w-2xl leading-relaxed">
        Con la tua firma destini a <strong class="text-foreground">Spazio Genesi ETS</strong> una quota
        dell’IRPEF che lo Stato comunque trattiene. Sostieni l’intera
        <strong class="text-foreground">attività associativa</strong> — lo spazio espositivo, le mostre, i workshop —
        e i servizi gratuiti come l’<a href="https://attestazione.spaziogenesi.org" target="_blank" rel="noopener" class="text-accent underline">attestazione delle opere digitali</a>
        e il suo <strong class="text-foreground">sigillo elettronico qualificato eIDAS</strong>.
      </p>

      <!-- CF box -->
      <div class="mt-8 inline-flex flex-col gap-2 p-6 rounded-xl border border-border bg-background">
        <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Codice fiscale da indicare</span>
        <div class="flex flex-wrap items-center gap-4">
          <span id="cf" class="text-3xl sm:text-4xl font-semibold text-foreground tracking-wider" style="font-family:var(--font-mono)">{CF}</span>
          <button id="copy-cf" type="button" data-cf={CF}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent text-accent-foreground text-sm font-semibold hover:opacity-90 transition-opacity">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
            </svg>
            <span id="copy-label">Copia</span>
          </button>
        </div>
        <span class="text-sm text-muted-foreground">Spazio Genesi ETS — Ente del Terzo Settore iscritto al RUNTS (rep. n. 174701)</span>
      </div>
    </div>
  </section>

  <!-- Come fare -->
  <section class="py-16 bg-background border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-foreground mb-8">Come destinarlo, in 3 passi</h2>
      <ol class="grid gap-6 md:grid-cols-3">
        {steps.map(([t, d], i) => (
          <li class="p-6 rounded-lg border border-border bg-card">
            <div class="w-9 h-9 rounded-full bg-accent text-accent-foreground flex items-center justify-center font-semibold mb-4">{i + 1}</div>
            <h3 class="text-lg font-semibold text-foreground mb-2" style="font-family:var(--font-sans)">{t}</h3>
            <p class="text-sm text-muted-foreground leading-relaxed">{d}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-muted-foreground">
        Il riquadro corretto è quello degli <strong class="text-foreground">enti del Terzo Settore iscritti nel RUNTS</strong>:
        Spazio Genesi ETS è regolarmente iscritta (rep. n. 174701).
      </p>
    </div>
  </section>

  <!-- Perché -->
  <section class="py-16 bg-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-foreground mb-3">Dove va il tuo contributo</h2>
      <p class="text-muted-foreground max-w-2xl leading-relaxed mb-8">
        Siamo un’associazione no-profit di matrice studentesca. Ogni euro torna agli studenti e ai giovani creativi:
      </p>
      <ul class="grid gap-4 sm:grid-cols-2 max-w-4xl">
        {[
          'Mantenere gratuito e open source il servizio di attestazione delle opere.',
          'Dotare ogni certificato del sigillo elettronico qualificato eIDAS.',
          'Workshop e materiali per accademie, scuole e concorsi.',
          'Far crescere lo spazio espositivo e le attività per gli studenti ABAQ.',
        ].map((p) => (
          <li class="flex items-start gap-3 text-foreground">
            <svg class="shrink-0 mt-1 text-accent" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span class="leading-relaxed">{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 bg-background border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="text-foreground mb-8">Domande frequenti</h2>
      <div class="max-w-3xl space-y-6">
        {faq.map(([q, a]) => (
          <div>
            <h3 class="text-base font-semibold text-foreground mb-1" style="font-family:var(--font-sans)">{q}</h3>
            <p class="text-muted-foreground leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA finale -->
  <section class="py-16 bg-background">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 text-center">
      <p class="text-xl text-foreground max-w-2xl mx-auto leading-relaxed mb-2" style="font-family:var(--font-display)">
        Una firma e un codice fiscale. Tutto qui.
      </p>
      <p class="text-3xl font-semibold text-foreground mb-8" style="font-family:var(--font-mono)">{CF}</p>
      <a href={u('/servizi/')}
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-border bg-background text-sm font-semibold text-foreground hover:border-accent hover:text-accent transition-colors">
        Scopri cosa facciamo
      </a>
    </div>
  </section>

  <script src="/scripts/copy-cf.js" is:inline></script>

</BaseLayout>
