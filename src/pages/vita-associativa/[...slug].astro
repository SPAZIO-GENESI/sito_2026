---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection, render } from 'astro:content'
import { u } from '../../utils/url'

export async function getStaticPaths() {
  const voci = await getCollection('comunicazioni', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
  return voci.map((v) => ({ params: { slug: v.id }, props: { v } }))
}

const { v } = Astro.props
const { Content } = await render(v)
const fmt = (d) => d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })
const MODALITA = {
  presenza: 'In presenza',
  online: 'Call online',
  mista: 'Ibrida',
  comunicazione: 'Comunicazione',
}
---
<BaseLayout
  title={`${v.data.title} — Spazio Genesi ETS`}
  description={v.data.description}
  activePage="attivita"
>
  <article class="py-16 lg:py-20 bg-background">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <a href={u('/vita-associativa/')} class="inline-flex items-center gap-2 text-sm font-semibold text-muted-foreground hover:text-accent transition-colors mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Vita associativa
      </a>

      <div class="flex items-center gap-3 flex-wrap">
        <time datetime={v.data.pubDate.toISOString()} class="text-xs font-semibold text-accent uppercase tracking-wider">
          {fmt(v.data.pubDate)}
        </time>
        <span class="text-xs px-2 py-0.5 bg-muted text-muted-foreground rounded-full">
          {MODALITA[v.data.modalita] ?? v.data.modalita}
        </span>
      </div>
      <h1 class="mt-2 mb-8 text-foreground">{v.data.title}</h1>

      <div class="news-body text-muted-foreground leading-relaxed">
        <Content />
      </div>
    </div>
  </article>

  <style is:global>
    .news-body p { margin-bottom: 1.1rem; }
    .news-body a { color: var(--accent); text-decoration: underline; }
    .news-body strong { color: var(--foreground); font-weight: 600; }
    .news-body ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.1rem; }
    .news-body li { margin-bottom: 0.4rem; }
    .news-body h2 { color: var(--foreground); margin: 1.8rem 0 0.8rem; }
  </style>
</BaseLayout>
