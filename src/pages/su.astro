---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout
  title="Genera Short URL — Spazio Genesi"
  description="Strumento interno per generare short URL Spazio Genesi."
  noindex={true}
  activePage=""
>
  <section class="py-16 lg:py-20 bg-secondary border-b border-border">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <h1 class="text-foreground mb-4">Genera Short URL</h1>
      <p class="text-lg text-muted-foreground max-w-2xl">
        Strumento interno: incolla un URL per ottenere una versione breve tramite il servizio Spazio Genesi.
      </p>
    </div>
  </section>

  <section class="py-16 bg-background">
    <div class="max-w-xl mx-auto px-6">
      <form id="shortenerForm" class="space-y-4">
        <label class="block text-sm font-medium text-foreground">
          URL originale
          <input
            type="text"
            id="originalURL"
            name="originalURL"
            required
            class="mt-2 w-full px-4 py-3 rounded-lg border border-border bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-accent"
          >
        </label>
        <button
          type="submit"
          class="w-full py-3 rounded-lg bg-accent text-accent-foreground font-medium hover:opacity-90 transition-opacity"
        >
          Genera
        </button>
      </form>

      <div id="qr" class="mt-8 min-h-[3rem] text-center">
        <p id="result" class="text-foreground break-all"></p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const baseEndpoint = 'https://sentinelle.mappa.asud.net/sg'

  const form = document.getElementById('shortenerForm')
  const result = document.getElementById('result')

  form?.addEventListener('submit', async (e) => {
    e.preventDefault()

    const input = document.getElementById('originalURL') as HTMLInputElement
    const originalURL = input.value.trim()
    if (!originalURL || !result) return

    result.textContent = 'Generazione in corso…'

    const endpoint = `${baseEndpoint}?originalURL=${encodeURIComponent(originalURL)}`

    try {
      const res = await fetch(endpoint)
      const data = await res.json()

      if (data.success && data.secureShortURL) {
        result.innerHTML = `<a href="${data.secureShortURL}" target="_blank" class="text-accent underline">${data.secureShortURL}</a>`
      } else {
        result.textContent = 'Errore nella risposta'
      }
    } catch {
      result.textContent = 'Errore di rete'
    }
  })
</script>
