---
import BaseLayout from '../layouts/BaseLayout.astro'
import { u } from '../utils/url'

const graphDataUrl = u('/graph_data.json')
---
<BaseLayout
  title="Grafo Semantico — Esplora i concetti di Spazio Genesi ETS"
  description="Mappa interattiva dei concetti ricorrenti estratti dai comunicati stampa di Spazio Genesi ETS. Esplora le relazioni semantiche tra artisti, temi e mostre a L'Aquila."
  activePage="grafo"
>
  <section class="py-10 bg-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h1 class="text-foreground mb-2">Grafo semantico</h1>
      <p class="text-muted-foreground text-sm max-w-2xl mb-4">
        Mappa dei concetti ricorrenti estratti dai comunicati stampa. Clicca un nodo per esplorare
        le relazioni semantiche e i testi in cui compare.
      </p>
      <p class="text-xs text-muted-foreground">
        testi: <strong id="m-docs" class="text-foreground font-medium">—</strong>
        &nbsp;·&nbsp;
        concetti: <strong id="m-nodes" class="text-foreground font-medium">—</strong>
        &nbsp;·&nbsp;
        relazioni: <strong id="m-edges" class="text-foreground font-medium">—</strong>
        &nbsp;·&nbsp;
        <span id="m-date"></span>
      </p>
    </div>
  </section>

  <div id="sg-panes" style="display:flex; height:calc(100vh - 220px); min-height:480px; border-top:1px solid var(--color-border);">

    <!-- GRAPH -->
    <div id="pane-graph" style="flex:1 1 auto; position:relative; overflow:hidden; background:#fff; min-width:200px;">
      <svg id="graph" style="width:100%; height:100%; display:block;">
        <g id="edges-g"></g>
        <g id="nodes-g"></g>
      </svg>
      <p id="graph-hint" style="position:absolute; bottom:8px; left:50%; transform:translateX(-50%); font-size:10px; color:#ccc; pointer-events:none; white-space:nowrap; font-family:system-ui,sans-serif;">
        trascina i nodi · clicca per esplorare
      </p>
    </div>

    <!-- DIVIDER -->
    <div id="sg-divider" style="width:5px; flex-shrink:0; cursor:col-resize; background:#f5f5f5; border-left:1px solid var(--color-border); border-right:1px solid var(--color-border); position:relative; transition:background 0.15s;" aria-hidden="true">
      <span style="position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); font-size:10px; color:#bbb; pointer-events:none;">⋮</span>
    </div>

    <!-- SIDEBAR -->
    <div id="pane-side" style="width:280px; min-width:160px; max-width:60%; flex-shrink:0; overflow-y:auto; background:#fff; text-align:left; font-family:system-ui,sans-serif;">
      <div style="padding:0.9rem;">
        <p class="sg-label">Nodo selezionato</p>
        <div id="hint" style="font-size:0.8rem; color:#777; line-height:1.6;">
          Clicca un concetto per vederne le relazioni semantiche e i comunicati in cui compare.
        </div>
        <div id="detail" style="display:none;">
          <p id="d-name" style="font-size:0.95rem; font-weight:600; margin-bottom:0.2rem; color:#111;"></p>
          <p id="d-meta" style="font-size:0.73rem; color:#777; margin-bottom:0.9rem; line-height:1.5;"></p>
          <div id="d-conns">
            <p class="sg-label" style="margin:0.8rem 0 0.4rem; border:none; padding:0;">Relazioni PMI</p>
            <div id="d-list"></div>
          </div>
          <div id="d-docs">
            <p class="sg-label" style="margin:0.8rem 0 0.4rem; border:none; padding:0;">Comunicati</p>
            <div id="d-doc-list"></div>
          </div>
        </div>
      </div>

      <div style="border-top:1px solid var(--color-border); padding:0.7rem 0.9rem;">
        <p class="sg-label" style="margin-bottom:0.5rem;">Categorie</p>
        <div class="sg-leg"><div class="sg-dot" style="background:#639922;"></div>corpo / figura</div>
        <div class="sg-leg"><div class="sg-dot" style="background:#534AB7;"></div>memoria / tempo</div>
        <div class="sg-leg"><div class="sg-dot" style="background:#0F6E56;"></div>spazio / luogo</div>
        <div class="sg-leg"><div class="sg-dot" style="background:#BA7517;"></div>processo / tecnica</div>
        <div class="sg-leg"><div class="sg-dot" style="background:#993556;"></div>relazione / emotività</div>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  .sg-label {
    font-size: 0.65rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.07em;
    color: #888; margin-bottom: 0.6rem;
    border-bottom: 1px solid #f0f0f0; padding-bottom: 0.3rem;
  }
  .sg-leg { display:flex; align-items:center; gap:6px; font-size:0.72rem; color:#555; margin-bottom:3px; }
  .sg-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
</style>

<!-- is:global perché D3 crea SVG dinamicamente senza hash Astro -->
<style is:global>
  /* SVG graph */
  .edge { fill:none; stroke:#999; stroke-opacity:0.25; }
  .edge.highlight { stroke:#333; stroke-opacity:0.7; }
  .edge.dim { stroke-opacity:0.05; }
  .node-g { cursor:pointer; }
  .node-g:hover .pill { stroke-width:1.5; }
  .pill { fill:#fff; stroke:#aaa; stroke-width:1; filter:drop-shadow(0 1px 2px rgba(0,0,0,0.07)); }
  .label { font-family:system-ui,sans-serif; font-weight:500; fill:#111; pointer-events:none; dominant-baseline:central; text-anchor:middle; }

  .cat-corpo    .pill { stroke:#639922; } .cat-corpo    .label { fill:#3B6D11; }
  .cat-memoria  .pill { stroke:#534AB7; } .cat-memoria  .label { fill:#3C3489; }
  .cat-spazio   .pill { stroke:#0F6E56; } .cat-spazio   .label { fill:#085041; }
  .cat-processo .pill { stroke:#BA7517; } .cat-processo .label { fill:#854F0B; }
  .cat-relazione .pill { stroke:#993556; } .cat-relazione .label { fill:#72243E; }

  .node-g.active .pill { stroke-width:2; filter:none; }
  .cat-corpo.node-g.active    .pill { fill:#639922; stroke:#639922; }
  .cat-memoria.node-g.active  .pill { fill:#534AB7; stroke:#534AB7; }
  .cat-spazio.node-g.active   .pill { fill:#0F6E56; stroke:#0F6E56; }
  .cat-processo.node-g.active .pill { fill:#BA7517; stroke:#BA7517; }
  .cat-relazione.node-g.active .pill { fill:#993556; stroke:#993556; }
  .node-g.active .label { fill:#fff; }

  /* Sidebar internals */
  .conn-row { display:flex; align-items:center; gap:6px; font-size:0.76rem; padding:4px 5px; border-radius:4px; cursor:pointer; color:#333; }
  .conn-row:hover { background:#f5f5f5; }
  .conn-label { min-width:68px; font-weight:500; }
  .conn-track { flex:1; height:2px; background:#eee; border-radius:2px; }
  .conn-fill  { height:100%; border-radius:2px; }
  .conn-pct   { font-size:10px; color:#aaa; min-width:22px; text-align:right; }
  .doc-card { border:1px solid #e8e8e8; border-radius:4px; padding:0.5rem 0.6rem; margin-bottom:0.4rem; background:#fafafa; }
  .doc-title { font-size:0.75rem; font-weight:600; color:#111; margin-bottom:0.2rem; line-height:1.3; }
  .doc-excerpt { font-size:0.7rem; color:#555; line-height:1.45; margin-bottom:0.3rem; }
  .doc-link { font-size:0.68rem; color:#185FA5; text-decoration:none; }
  .doc-link:hover { text-decoration:underline; }
  .doc-no-pdf { font-size:0.68rem; color:#bbb; }

  @media (max-width: 767px) {
    #sg-panes { flex-direction:column !important; height:auto !important; }
    #pane-graph { height:70vw; min-height:300px; max-height:420px; flex:none !important; }
    #pane-side { width:100% !important; max-width:100%; min-width:0; }
    #sg-divider { display:none !important; }
  }
</style>

<script src="/scripts/grafo.js" is:inline></script>
