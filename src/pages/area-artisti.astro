---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout
  title="Area artisti — Spazio Genesi"
  description="Accesso riservato agli artisti per aggiornare la propria biografia."
  noindex={true}
  activePage=""
>
  <section class="py-16 lg:py-24 bg-secondary border-b border-border">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <p class="text-xs font-semibold text-accent uppercase tracking-[0.3em] mb-4">Area artisti</p>
      <h1 class="text-foreground mb-4">La tua biografia</h1>
      <p class="text-muted-foreground leading-relaxed mb-8">
        Accedi con l'indirizzo email associato alla tua scheda per aggiornare la tua biografia.
        Le modifiche sono pubblicate subito.
      </p>

      <!-- Login -->
      <div id="login-box">
        <div id="gbtn"></div>
        <p id="login-hint" class="text-sm text-muted-foreground mt-4"></p>
      </div>

      <!-- Editor (nascosto finché non si accede) -->
      <form id="editor" class="hidden mt-2 space-y-6">
        <div class="flex items-center justify-between gap-4 flex-wrap">
          <p class="text-sm text-muted-foreground">Accesso come <b id="acct" class="text-foreground"></b></p>
          <button type="button" id="logout" class="text-sm text-accent hover:opacity-80 underline">Esci</button>
        </div>

        <label class="block">
          <span class="text-sm font-semibold text-foreground">Nome</span>
          <input id="f-nome" type="text" maxlength="120"
            class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" />
        </label>

        <div>
          <span class="text-sm font-semibold text-foreground">Biografia</span>
          <span class="block text-xs text-muted-foreground mb-1">Usa i pulsanti per grassetto, corsivo, link e linea. A capo = Invio.</span>
          <div class="mt-1 border border-border rounded-lg overflow-hidden bg-background">
            <div id="f-bio-tb" class="flex flex-wrap gap-1 p-2 border-b border-border bg-secondary text-sm">
              <button type="button" data-cmd="bold" class="px-2.5 py-1 rounded hover:bg-muted font-bold" title="Grassetto">G</button>
              <button type="button" data-cmd="italic" class="px-2.5 py-1 rounded hover:bg-muted italic" title="Corsivo">C</button>
              <button type="button" data-cmd="insertUnorderedList" class="px-2.5 py-1 rounded hover:bg-muted" title="Elenco puntato">• elenco</button>
              <button type="button" data-cmd="createLink" class="px-2.5 py-1 rounded hover:bg-muted" title="Inserisci link">🔗 link</button>
              <button type="button" data-cmd="unlink" class="px-2.5 py-1 rounded hover:bg-muted" title="Togli link">✕ link</button>
              <button type="button" data-cmd="insertHorizontalRule" class="px-2.5 py-1 rounded hover:bg-muted" title="Linea separatrice">— linea</button>
            </div>
            <div id="f-bio" contenteditable="true" class="px-4 py-3 min-h-[200px] text-foreground leading-relaxed focus:outline-none"></div>
          </div>
        </div>

        <div class="grid sm:grid-cols-3 gap-4">
          <label class="block">
            <span class="text-sm font-semibold text-foreground">Instagram (handle)</span>
            <input id="f-ig" type="text" maxlength="80" placeholder="nomeutente"
              class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-foreground">Altro social (URL)</span>
            <input id="f-social" type="url" maxlength="500" placeholder="https://…"
              class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" />
          </label>
          <label class="block">
            <span class="text-sm font-semibold text-foreground">Portfolio</span>
            <input id="f-portfolio" type="text" maxlength="200" placeholder="link o nome file PDF"
              class="mt-1 w-full px-4 py-2 border border-border rounded-lg bg-background text-foreground" />
          </label>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" id="save"
            class="inline-flex items-center gap-2 bg-accent text-accent-foreground px-6 py-3 rounded-lg font-semibold hover:opacity-90 transition-opacity">
            Salva e pubblica
          </button>
          <p id="status" class="text-sm" aria-live="polite"></p>
        </div>
        <p class="text-xs text-muted-foreground">
          Anteprima pubblica: <a id="preview-link" class="text-accent underline" target="_blank" rel="noopener">la tua scheda</a>
        </p>

        <div class="pt-6 mt-2 border-t border-border">
          <h3 class="text-foreground font-semibold mb-1">Foto</h3>
          <p class="text-xs text-muted-foreground mb-4">La <b>prima</b> immagine è il ritratto. Foto JPG/PNG/WebP (max 8 MB) o <b>video</b> MP4/WebM (max 64 MB). I video si vedono con play e audio. Le modifiche sono immediate.</p>
          <div id="foto-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-4"></div>
          <div class="flex flex-wrap items-center gap-3">
            <input id="foto-file" type="file" accept="image/*,video/mp4,video/webm" class="text-sm" />
            <input id="foto-des" type="text" placeholder="didascalia breve (opzionale)" class="px-3 py-2 border border-border rounded-lg bg-background text-foreground text-sm flex-1 min-w-[180px]" />
            <button type="button" id="foto-up" class="bg-accent text-accent-foreground px-4 py-2 rounded-lg text-sm font-semibold">Carica</button>
            <span id="foto-status" class="text-xs"></span>
          </div>

          <div id="fcap" class="hidden mt-4 p-4 border border-border rounded-lg bg-secondary">
            <p class="text-sm font-semibold text-foreground mb-2">Descrizione della foto</p>
            <input id="fcap-des" type="text" placeholder="didascalia breve" class="w-full px-3 py-2 border border-border rounded-lg bg-background text-foreground text-sm mb-3" />
            <span class="block text-xs text-muted-foreground mb-1">Descrizione estesa (con formattazione):</span>
            <div class="border border-border rounded-lg overflow-hidden bg-background">
              <div id="fcap-tb" class="flex flex-wrap gap-1 p-2 border-b border-border bg-secondary text-sm">
                <button type="button" data-cmd="bold" class="px-2.5 py-1 rounded hover:bg-muted font-bold">G</button>
                <button type="button" data-cmd="italic" class="px-2.5 py-1 rounded hover:bg-muted italic">C</button>
                <button type="button" data-cmd="insertUnorderedList" class="px-2.5 py-1 rounded hover:bg-muted">• elenco</button>
                <button type="button" data-cmd="createLink" class="px-2.5 py-1 rounded hover:bg-muted">🔗 link</button>
                <button type="button" data-cmd="unlink" class="px-2.5 py-1 rounded hover:bg-muted">✕ link</button>
                <button type="button" data-cmd="insertHorizontalRule" class="px-2.5 py-1 rounded hover:bg-muted">— linea</button>
              </div>
              <div id="fcap-long" contenteditable="true" class="px-4 py-3 min-h-[120px] text-foreground leading-relaxed focus:outline-none"></div>
            </div>
            <div class="flex items-center gap-3 mt-3">
              <button type="button" id="fcap-save" class="bg-accent text-accent-foreground px-4 py-2 rounded-lg text-sm font-semibold">Salva descrizione</button>
              <button type="button" id="fcap-cancel" class="text-sm text-accent underline">Annulla</button>
              <span id="fcap-status" class="text-xs"></span>
            </div>
          </div>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>

<script is:inline src="/visual-editor.js"></script>
<script is:inline src="https://accounts.google.com/gsi/client" async></script>
<script src="/scripts/area-artisti.js" is:inline></script>
