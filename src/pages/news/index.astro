---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'
import { u } from '../../utils/url'
import DiarioTabs from '../../components/DiarioTabs.astro'

const posts = (await getCollection('news', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())

const fmt = (d) => d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })
---
<BaseLayout
  title="News — Spazio Genesi ETS, Arte Contemporanea L'Aquila"
  description="Notizie e tappe del progetto Spazio Genesi ETS: riconoscimenti, servizi, vita associativa."
  activePage="attivita"
>
  <section class="py-16 lg:py-20 bg-secondary border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h1 class="text-foreground mb-4">Diario</h1>
      <p class="text-lg text-muted-foreground max-w-2xl mb-8 leading-relaxed">
        Le tappe e gli annunci di Spazio Genesi ETS: riconoscimenti, servizi e vita associativa.
      </p>
      <DiarioTabs active="news" />
    </div>
  </section>

  <section class="py-12 lg:py-16 bg-background">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      {posts.length === 0 ? (
        <p class="text-muted-foreground">Nessuna notizia pubblicata al momento.</p>
      ) : (
        <ul class="divide-y divide-border">
          {posts.map((post) => (
            <li class="py-8 first:pt-0">
              <article>
                <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold text-accent uppercase tracking-wider">
                  {fmt(post.data.pubDate)}
                </time>
                <h2 class="mt-2 mb-3 text-foreground">
                  <a href={u(`/news/${post.id}/`)} class="hover:text-accent transition-colors">{post.data.title}</a>
                </h2>
                <p class="text-muted-foreground leading-relaxed">{post.data.description}</p>
                <a href={u(`/news/${post.id}/`)} class="inline-flex items-center gap-2 mt-4 text-sm font-semibold text-accent hover:opacity-80 transition-opacity">
                  Leggi
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
              </article>
            </li>
          ))}
        </ul>
      )}

      <p class="mt-12 pt-6 border-t border-border text-sm text-muted-foreground">
        <a href={u('/news/rss.xml')} class="hover:text-accent transition-colors">Feed RSS</a>
      </p>
    </div>
  </section>
</BaseLayout>
