---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { getCollection, render } from 'astro:content'
import { u } from '../../utils/url'

export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}

const { post } = Astro.props
const { Content } = await render(post)
const fmt = (d) => d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' })
---
<BaseLayout
  title={`${post.data.title} — Spazio Genesi ETS`}
  description={post.data.description}
  activePage="attivita"
>
  <article class="py-16 lg:py-20 bg-background">
    <div class="max-w-3xl mx-auto px-6 lg:px-8">
      <a href={u('/news/')} class="inline-flex items-center gap-2 text-sm font-semibold text-muted-foreground hover:text-accent transition-colors mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Tutte le news
      </a>

      <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold text-accent uppercase tracking-wider">
        {fmt(post.data.pubDate)}
      </time>
      <h1 class="mt-2 mb-8 text-foreground">{post.data.title}</h1>

      <div class="news-body text-muted-foreground leading-relaxed">
        <Content />
      </div>
    </div>
  </article>

  <style is:global>
    .news-body p { margin-bottom: 1.1rem; }
    .news-body a { color: var(--accent); text-decoration: underline; }
    .news-body strong { color: var(--foreground); font-weight: 600; }
    .news-body ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.1rem; }
    .news-body li { margin-bottom: 0.4rem; }
    .news-body h2 { color: var(--foreground); margin: 1.8rem 0 0.8rem; }
    .news-body figure { margin: 2rem 0; }
    .news-body img { display: block; width: 100%; height: auto; border-radius: 0.5rem; border: 1px solid var(--border); background: var(--secondary); }
    .news-body figcaption { margin-top: 0.6rem; font-size: 0.85rem; color: var(--muted-foreground); text-align: center; }
    .news-body blockquote { margin: 1.8rem 0; padding: 0.2rem 0 0.2rem 1.25rem; border-left: 3px solid var(--accent); color: var(--foreground); font-style: italic; }
    .news-body blockquote p:last-child { margin-bottom: 0; }
  </style>
</BaseLayout>
