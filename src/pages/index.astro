---
import BaseLayout from '../layouts/BaseLayout.astro'
import data from '../data/artisti.json'
import mostra from '../data/mostra_corrente.json'
import { flattenImmagini } from '../types'
import type { Artista } from '../types'
import { u } from '../utils/url'

const artisti = data.artisti as Artista[]
// Ultime 3 inserite = ultime in bio.json, più recente prima
const ultimeInserite = artisti.slice(-3).reverse()
---
<BaseLayout
  title="Spazio Genesi — Arte Contemporanea, L'Aquila"
  description={`Spazio Genesi ETS: ${mostra.tipo}. ${mostra.titolo}, ${mostra.vernissage}. Laboratorio permanente, Accademia di Belle Arti L'Aquila.`}
  ogImage={mostra.immagine}
>

  <!-- ① MOSTRA CORRENTE ------------------------------------------------- -->
  <section class="bg-background border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-10 lg:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- Immagine: ritaglio superiore ~1/3 altezza viewport -->
        <div>
          <img
            src={mostra.immagine}
            alt={`Locandina mostra: ${mostra.titolo}`}
            class="w-full h-64 lg:h-72 object-cover object-top rounded-lg shadow-lg"
          />
        </div>

        <!-- Testo -->
        <div>
          <span class="text-accent font-semibold text-sm uppercase tracking-wider">Mostra in corso</span>
          <h1 class="mt-3 mb-2 text-foreground">{mostra.titolo}</h1>
          <p class="text-muted-foreground mb-6">{mostra.tipo}</p>

          <dl class="space-y-3 text-sm mb-8">
            <div class="flex gap-3">
              <dt class="font-semibold text-foreground shrink-0 w-28">Vernissage</dt>
              <dd class="text-muted-foreground">{mostra.vernissage}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-semibold text-foreground shrink-0 w-28">Luogo</dt>
              <dd class="text-muted-foreground">
                <a href={mostra.mappa} target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80 transition-opacity underline">
                  {mostra.luogo}
                </a>
              </dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-semibold text-foreground shrink-0 w-28">A cura di</dt>
              <dd class="text-muted-foreground">
                <a href={u(mostra.curata_da.href)} class="text-accent hover:opacity-80 transition-opacity underline">
                  {mostra.curata_da.nome}
                </a>
              </dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-semibold text-foreground shrink-0 w-28">Artiste</dt>
              <dd class="text-muted-foreground">{mostra.artiste}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-semibold text-foreground shrink-0 w-28">Coordinamento</dt>
              <dd class="text-muted-foreground">{mostra.coordinamento}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-semibold text-foreground shrink-0 w-28">Grafica</dt>
              <dd class="text-muted-foreground">{mostra.grafica}</dd>
            </div>
            <div class="flex gap-3">
              <dt class="font-semibold text-foreground shrink-0 w-28">Allestimento</dt>
              <dd class="text-muted-foreground">{mostra.allestimento}</dd>
            </div>
          </dl>

          <div class="flex flex-wrap gap-3 mb-8">
            <a href={mostra.comunicato} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-accent text-accent-foreground px-5 py-2.5 rounded-lg text-sm font-semibold hover:opacity-90 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <path d="m7 10 5 5 5-5"/>
              </svg>
              Comunicato stampa
            </a>
          </div>

          <!-- Rassegna stampa -->
          {mostra.rassegna_stampa.length > 0 && (
            <div>
              <h3 class="text-sm font-semibold text-foreground mb-2">Rassegna stampa</h3>
              <ul class="space-y-2">
                {mostra.rassegna_stampa.map((art: { testata: string; titolo: string; url: string }) => (
                  <li class="text-sm">
                    <a href={art.url} target="_blank" rel="noopener noreferrer"
                      class="text-accent hover:opacity-80 transition-opacity underline">
                      <span class="font-semibold">{art.testata}</span> — {art.titolo}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ② RICONOSCIMENTI + ADESIONI --------------------------------------- -->
  <section class="bg-secondary border-b border-border py-6">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-wrap gap-6 items-center">
      {mostra.riconoscimenti.length > 0 && (
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Riconoscimenti</span>
          {mostra.riconoscimenti.map(r => (
            <a href={r.url} target="_blank" rel="noopener noreferrer"
              class="text-sm text-accent hover:opacity-80 transition-opacity font-medium underline">
              {r.label}
            </a>
          ))}
        </div>
      )}
      {mostra.adesioni.length > 0 && (
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold text-muted-foreground uppercase tracking-wider">Adesioni</span>
          {mostra.adesioni.map(a => (
            <a href={a.url} target="_blank" rel="noopener noreferrer"
              class="text-sm text-accent hover:opacity-80 transition-opacity font-medium underline">
              {a.label}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- ③ ULTIME 3 BIOGRAFIE INSERITE ------------------------------------- -->
  <section class="py-20 lg:py-28 bg-background">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline justify-between mb-12">
        <h2 class="text-foreground">Ultime biografie</h2>
        <a href={u('/biografie/')} class="text-sm text-accent font-semibold hover:opacity-80 transition-opacity flex items-center gap-1">
          Tutte le biografie
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {ultimeInserite.map(artista => {
          const imgs = flattenImmagini(artista.img)
          const img = imgs.find(i => i.img)
          const nome = decodeURIComponent(artista.nome)
          return (
            <a href={u(`/biografie/${artista.cartella}/`)} class="group block">
              <div class="overflow-hidden rounded-lg mb-4 aspect-video bg-muted">
                {img && (
                  <img src={u(`/biografie/${artista.cartella}/${img.img}`)} alt={nome}
                    class="w-full h-full object-cover group-hover:opacity-80 transition-opacity" loading="lazy" />
                )}
              </div>
              <h3 class="text-foreground mb-1 group-hover:text-accent transition-colors">{nome}</h3>
              <p class="text-sm text-accent font-semibold flex items-center gap-1">
                Biografia
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                </svg>
              </p>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <!-- ④ PROFILI SOCIAL + RISORSE --------------------------------------- -->
  <section class="py-20 lg:py-28 bg-secondary border-t border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

        <!-- Social -->
        <div>
          <h3 class="text-foreground mb-5 text-lg font-display">Profili Social</h3>
          <ul class="space-y-3">
            <li>
              <a href="https://www.instagram.com/spaziogenesi/" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
                Instagram @spaziogenesi
              </a>
            </li>
            <li>
              <a href="https://www.facebook.com/spaziogenesi" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
                Facebook
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/company/spazio-genesi-ets" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                  <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
                </svg>
                LinkedIn
              </a>
            </li>
            <li>
              <a href="https://whatsapp.com/channel/0029VafVCDW2v1IxLIql5T2e" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Canale WhatsApp
              </a>
            </li>
          </ul>
        </div>

        <!-- Risorse Pubbliche -->
        <div>
          <h3 class="text-foreground mb-5 text-lg font-display">Risorse Pubbliche</h3>
          <ul class="space-y-3">
            <li>
              <a href="https://dutyfree.spaziogenesi.org" target="_blank" rel="noopener noreferrer"
                class="flex items-start gap-3 text-muted-foreground hover:text-accent transition-colors group">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="mt-0.5 shrink-0" aria-hidden="true">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                </svg>
                <span>
                  <span class="font-medium text-foreground group-hover:text-accent transition-colors">Corner Fumetti Indipendenti</span><br>
                  <span class="text-xs">dutyfree.spaziogenesi.org</span>
                </span>
              </a>
            </li>
            <li>
              <a href={u('/centrodocumentazione_libri/')}
                class="flex items-start gap-3 text-muted-foreground hover:text-accent transition-colors group">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="mt-0.5 shrink-0" aria-hidden="true">
                  <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
                </svg>
                <span>
                  <span class="font-medium text-foreground group-hover:text-accent transition-colors">Centro Documentazione Ivan Donatelli</span><br>
                  <span class="text-xs">Catalogo libri e cataloghi d'arte</span>
                </span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Risorse Associati + ABAQ -->
        <div>
          <h3 class="text-foreground mb-5 text-lg font-display">Risorse Associati + ABAQ</h3>
          <ul class="space-y-3 text-sm">
            <li class="text-muted-foreground">
              <span class="font-medium text-foreground">ZONA FRANCA Study Room</span><br>
              Lun–Sab ore 17:30–19:30
            </li>
            <li class="text-muted-foreground">
              Zines/riviste: <em>Osservatorio Futura, Arte&amp;Critica City, E.T. Zine</em>
            </li>
            <li>
              <a href="https://spazio-genesi.github.io/sg_assemblee/" target="_blank" rel="noopener noreferrer"
                class="text-accent hover:opacity-80 transition-opacity underline">
                Verbali assemblee
              </a>
            </li>
            <li>
              <a href="https://forms.gle/fmbbhtUQLkwkMjqH9" target="_blank" rel="noopener noreferrer"
                class="text-accent hover:opacity-80 transition-opacity underline">
                Candidatura mostra personale
              </a>
            </li>
            <li>
              <a href="mailto:info@spaziogenesi.org?subject=Iscrizione mailing list"
                class="text-accent hover:opacity-80 transition-opacity underline">
                Iscrizione mailing list
              </a>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ⑤ NEWS TICKER ----------------------------------------------------- -->
  <div class="bg-background border-t border-border py-2">
    <div class="max-w-7xl mx-auto flex items-center">
      <span class="shrink-0 bg-red-600 text-white text-xs font-semibold px-3 py-2 mr-3">News</span>
      <div class="overflow-hidden text-sm text-muted-foreground">
        <marquee behavior="scroll" direction="left" onmouseover="this.stop();" onmouseout="this.start();">
          laboratorio permanente di interazione — noi che...voi che...presente e futuro — autogestito —
          riservato ad iscritt* ABAQ + Erasmus — multi manifesto — tutte le tecniche — rotazione espositiva —
          archivio donazioni — caffè letterario — conviviale — assemblea aperta — spazio safe
        </marquee>
      </div>
    </div>
  </div>

</BaseLayout>
