---
import BaseLayout from '../layouts/BaseLayout.astro'
import data from '../data/artisti.json'
import mostra from '../data/mostra_corrente.json'
import { flattenImmagini, extractAbstract } from '../types'
import type { Artista } from '../types'
import { u } from '../utils/url'

const artisti = data.artisti as Artista[]
const ultimeInserite = artisti.slice(-3).reverse()

type Persona = { nome: string; href?: string }

function renderPersone(persone: Persona[]) {
  return persone
}

const eventSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ExhibitionEvent',
  name: mostra.titolo,
  description: mostra.tipo,
  startDate: mostra.startDateISO,
  location: {
    '@type': 'Place',
    name: mostra.luogo,
    geo: {
      '@type': 'GeoCoordinates',
      latitude: 42.3561053,
      longitude: 13.3884423,
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Spazio Genesi ETS',
    url: 'https://spaziogenesi.org',
  },
  image: mostra.immagine,
  url: 'https://spaziogenesi.org/',
})
---
<BaseLayout
  title="Spazio Genesi — Arte Contemporanea, L'Aquila"
  description={`Spazio Genesi ETS: ${mostra.tipo}. ${mostra.titolo}, ${mostra.vernissage}. Laboratorio permanente, Accademia di Belle Arti L'Aquila.`}
  ogImage={mostra.immagine}
  schemaLD={eventSchema}
>

  <!-- ① MOSTRA CORRENTE: testo sinistra, immagine destra -->
  <section class="bg-background border-b border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-10 lg:py-14">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">

        <!-- Colonna sinistra: testo (stile B12) -->
        <div class="order-2 lg:order-1">
          <span class="text-accent font-semibold text-sm uppercase tracking-wider">Mostra in corso</span>
          <h1 class="mt-3 mb-2 text-foreground">{mostra.titolo}</h1>
          <p class="text-muted-foreground mb-5">{mostra.tipo}</p>

          <p class="text-sm text-muted-foreground mb-6">
            <strong class="text-foreground">{mostra.vernissage}</strong><br>
            <a href={mostra.mappa} target="_blank" rel="noopener noreferrer"
              class="text-accent hover:opacity-80 transition-opacity underline">
              {mostra.luogo}
            </a>
          </p>

          <!-- Scheda tecnica -->
          <dl class="space-y-2 text-sm mb-6 border-l-2 border-border pl-4">
            <div class="flex gap-2 flex-wrap">
              <dt class="font-semibold text-foreground shrink-0">A cura di</dt>
              <dd class="text-muted-foreground">
                {mostra.curata_da.href
                  ? <a href={u(mostra.curata_da.href)} class="text-accent hover:opacity-80 underline">{mostra.curata_da.nome}</a>
                  : mostra.curata_da.nome}
              </dd>
            </div>
            <div class="flex gap-2 flex-wrap">
              <dt class="font-semibold text-foreground shrink-0">{mostra.artiste.length === 1 ? 'Artista' : 'Artiste'}</dt>
              <dd class="text-muted-foreground">
                {(mostra.artiste as Persona[]).map((p, i) => (
                  <Fragment>
                    {p.href
                      ? <a href={u(p.href)} class="text-accent hover:opacity-80 underline">{p.nome}</a>
                      : p.nome}
                    {i < mostra.artiste.length - 1 ? ', ' : ''}
                  </Fragment>
                ))}
              </dd>
            </div>
            <div class="flex gap-2 flex-wrap">
              <dt class="font-semibold text-foreground shrink-0">Coordinamento</dt>
              <dd class="text-muted-foreground">
                {(mostra.coordinamento as Persona[]).map((p, i) => (
                  <Fragment>
                    {p.href
                      ? <a href={u(p.href)} class="text-accent hover:opacity-80 underline">{p.nome}</a>
                      : p.nome}
                    {i < mostra.coordinamento.length - 1 ? ', ' : ''}
                  </Fragment>
                ))}
              </dd>
            </div>
            <div class="flex gap-2 flex-wrap">
              <dt class="font-semibold text-foreground shrink-0">Grafica</dt>
              <dd class="text-muted-foreground">
                {(mostra.grafica as Persona[]).map((p, i) => (
                  <Fragment>
                    {p.href
                      ? <a href={p.href} target="_blank" rel="noopener noreferrer" class="text-accent hover:opacity-80 underline">{p.nome}</a>
                      : p.nome}
                    {i < mostra.grafica.length - 1 ? ', ' : ''}
                  </Fragment>
                ))}
              </dd>
            </div>
            <div class="flex gap-2 flex-wrap">
              <dt class="font-semibold text-foreground shrink-0">Allestimento</dt>
              <dd class="text-muted-foreground">
                {(mostra.allestimento as Persona[]).map((p, i) => (
                  <Fragment>
                    {p.href
                      ? <a href={u(p.href)} class="text-accent hover:opacity-80 underline">{p.nome}</a>
                      : p.nome}
                    {i < mostra.allestimento.length - 1 ? ', ' : ''}
                  </Fragment>
                ))}
              </dd>
            </div>
          </dl>

          <div class="flex flex-wrap gap-3 mb-6">
            <a href={mostra.comunicato} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-accent text-accent-foreground px-5 py-2.5 rounded-lg text-sm font-semibold hover:opacity-90 transition-opacity">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                <path d="m7 10 5 5 5-5"/>
              </svg>
              Comunicato stampa
            </a>
          </div>

          {mostra.rassegna_stampa.length > 0 && (
            <div>
              <p class="text-xs font-semibold text-foreground uppercase tracking-wider mb-2">Rassegna stampa</p>
              <ul class="space-y-1.5">
                {(mostra.rassegna_stampa as {testata:string;titolo:string;url:string}[]).map(art => (
                  <li class="text-sm">
                    <a href={art.url} target="_blank" rel="noopener noreferrer"
                      class="text-accent hover:opacity-80 transition-opacity">
                      <span class="font-semibold">{art.testata}</span> — {art.titolo}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Colonna destra: carosello 4 immagini -->
        <div class="order-1 lg:order-2">
          <div id="carousel" class="relative w-full h-64 lg:h-72 rounded-lg shadow-lg overflow-hidden">
            {(mostra.galleria as string[]).map((src, i) => (
              <img
                src={u(src)}
                alt={`${mostra.titolo} — foto ${i + 1}`}
                class={`carousel-slide absolute inset-0 w-full h-full object-cover transition-opacity duration-700 ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
            <!-- Indicatori -->
            <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5">
              {(mostra.galleria as string[]).map((_, i) => (
                <button
                  class={`carousel-dot w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-white' : 'bg-white/40'}`}
                  data-index={i}
                  aria-label={`Foto ${i + 1}`}
                />
              ))}
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ② RICONOSCIMENTI + ADESIONI con loghi -->
  <section class="bg-secondary border-b border-border py-4">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-wrap gap-6 items-center">
      {(mostra.riconoscimenti as {label:string;url:string;logo:string;logoAlt:string}[]).map(r => (
        <a href={r.url} target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors group">
          <img src={r.logo} alt={r.logoAlt} class="h-5 opacity-70 group-hover:opacity-100 transition-opacity" />
          <span class="text-xs">{r.label}</span>
        </a>
      ))}
      <span class="text-border">|</span>
      {(mostra.adesioni as {label:string;url:string;logo:string;logoAlt:string}[]).map(a => (
        <a href={a.url} target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-2 text-muted-foreground hover:text-foreground transition-colors group">
          <img src={a.logo} alt={a.logoAlt} class="h-5 opacity-70 group-hover:opacity-100 transition-opacity" onError="this.style.display='none'" />
          <span class="text-xs">{a.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ③ ULTIME 3 BIOGRAFIE con abstract -->
  <section class="py-20 lg:py-28 bg-background">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="flex items-baseline justify-between mb-12">
        <h2 class="text-foreground">Ultime biografie</h2>
        <a href={u('/biografie/')} class="text-sm text-accent font-semibold hover:opacity-80 transition-opacity flex items-center gap-1">
          Tutte
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {ultimeInserite.map(artista => {
          const imgs = flattenImmagini(artista.img)
          const img = imgs.find(i => i.img)
          const nome = decodeURIComponent(artista.nome)
          const abstract = extractAbstract(artista.bio, 130)
          return (
            <a href={u(`/biografie/${artista.cartella}/`)} class="group block">
              <div class="overflow-hidden rounded-lg mb-3 aspect-video bg-muted">
                {img && (
                  <img src={u(`/biografie/${artista.cartella}/${img.img}`)} alt={nome}
                    class="w-full h-full object-cover group-hover:opacity-80 transition-opacity" loading="lazy" />
                )}
              </div>
              <h3 class="text-foreground mb-1 group-hover:text-accent transition-colors">{nome}</h3>
              <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">{abstract}</p>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <!-- ④ ABOUT (traduzione dalla descrizione B12) -->
  <section class="py-16 lg:py-20 bg-background border-t border-border">
    <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
      <h2 class="text-foreground mb-6">Chi siamo</h2>
      <p class="text-lg text-muted-foreground leading-relaxed mb-4">
        Spazio Genesi è un'associazione autogestita nata dentro l'Accademia di Belle Arti dell'Aquila,
        dove gestiamo uno spazio espositivo dedicato all'arte contemporanea.
      </p>
      <p class="text-muted-foreground leading-relaxed mb-4">
        Siamo un laboratorio per chi sta ancora studiando e, allo stesso tempo, un appoggio per chi dall'Accademia
        è già uscito: il posto dove la ricerca iniziata tra i corsi continua, incontra un pubblico e trova gli
        strumenti per reggersi da sola. Non si smette di farne parte quando finisce il percorso accademico —
        si cambia ruolo.
      </p>
      <p class="text-muted-foreground leading-relaxed mb-4">
        Mettiamo a disposizione quello che di solito hai solo quando sei già dentro al sistema dell'arte:
        uno spazio fisico vero dove mostrare il lavoro, un servizio gratuito di attestazione delle opere digitali
        per proteggerne la paternità, un canale editoriale per il fumetto e l'illustrazione indipendente,
        una comunità che ti fa da contesto. Organizziamo mostre a rotazione, eventi e presentazioni,
        e teniamo aperto un archivio e risorse di studio.
      </p>
      <p class="text-muted-foreground leading-relaxed mb-8">
        Lo spazio è di chi si associa e ne condivide le regole: autogestito, conviviale, safe.
      </p>
      <a href={u('/chisiamo/')} class="inline-flex items-center gap-2 text-accent font-semibold hover:opacity-80 transition-opacity">
        Scopri di più
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- ⑤ SOCIAL + RISORSE PUBBLICHE + RISORSE ABAQ -->
  <section class="py-20 lg:py-28 bg-secondary border-t border-border">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

        <!-- Social -->
        <div>
          <h3 class="text-foreground mb-5">Profili Social</h3>
          <ul class="space-y-3">
            <li>
              <a href="https://www.instagram.com/spaziogenesi/" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                Instagram @spaziogenesi
              </a>
            </li>
            <li>
              <a href="https://www.facebook.com/spaziogenesi" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                Facebook
              </a>
            </li>
            <li>
              <a href="https://www.linkedin.com/company/spazio-genesi-ets" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
                LinkedIn
              </a>
            </li>
            <li>
              <a href="https://whatsapp.com/channel/0029VafVCDW2v1IxLIql5T2e" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-accent transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Canale WhatsApp
              </a>
            </li>
          </ul>
        </div>

        <!-- Risorse Pubbliche con loghi -->
        <div>
          <h3 class="text-foreground mb-5">Risorse Pubbliche</h3>
          <ul class="space-y-4">
            <li>
              <a href="https://dutyfree.spaziogenesi.org" target="_blank" rel="noopener noreferrer"
                class="flex items-center gap-3 text-muted-foreground hover:text-foreground transition-colors group">
                <img src="https://dutyfree.spaziogenesi.org/img/dutyfree_p1.png"
                  alt="Corner Fumetti Indipendenti"
                  class="h-10 w-10 object-contain rounded opacity-80 group-hover:opacity-100 transition-opacity"
                />
                <span>
                  <span class="text-sm font-medium text-foreground group-hover:text-accent transition-colors block">Corner Fumetti Indipendenti</span>
                  <span class="text-xs text-muted-foreground">dutyfree.spaziogenesi.org</span>
                </span>
              </a>
            </li>
            <li>
              <a href={u('/centrodocumentazione_libri/')}
                class="flex items-center gap-3 text-muted-foreground hover:text-foreground transition-colors group">
                <!-- CDID logo SVG (dal centrodocumentazione_libri.html) -->
                <svg version="1.0" xmlns="http://www.w3.org/2000/svg"
                  width="48" height="28" viewBox="0 0 492 224"
                  preserveAspectRatio="xMidYMid meet"
                  class="opacity-70 group-hover:opacity-100 transition-opacity shrink-0" aria-hidden="true">
                  <g transform="translate(0,224) scale(0.1,-0.1)" fill="currentColor" stroke="none">
                    <path d="M850 2120 c-102 -16 -170 -33 -170 -42 0 -5 14 -30 32 -55 l31 -46 36 42 36 41 110 0 c339 -1 652 -62 867 -170 166 -83 335 -216 412 -324 56 -79 75 -93 45 -35 -147 292 -453 489 -884 570 -122 23 -419 34 -515 19z"/>
                    <path d="M4642 1969 c-335 -171 -553 -232 -1057 -294 -358 -44 -471 -61 -617 -91 -361 -76 -538 -196 -538 -365 0 -121 86 -329 219 -530 83 -126 169 -225 184 -210 5 5 10 34 10 63 0 66 -22 110 -103 203 -114 132 -158 263 -139 414 10 82 33 133 81 177 116 107 255 151 767 239 465 80 615 113 819 181 182 61 412 183 492 260 13 13 22 23 20 23 -3 -1 -65 -32 -138 -70z"/>
                    <path d="M395 1893 c-33 -2 -64 -8 -69 -13 -5 -5 0 -31 12 -62 11 -29 29 -80 39 -112 25 -84 39 -82 47 6 11 120 -13 108 231 108 512 0 921 -106 1300 -337 44 -27 94 -57 110 -67 78 -48 -173 163 -260 219 -134 85 -290 153 -450 195 -206 55 -275 62 -600 65 -165 1 -327 0 -360 -2z"/>
                    <path d="M675 1240 c-180 -15 -372 -40 -501 -66 -130 -25 -174 -38 -174 -52 0 -5 53 -53 117 -108 206 -174 730 -644 913 -818 41 -39 104 -99 140 -133 l65 -62 70 20 c334 94 878 99 1403 13 l44 -7 -44 69 c-53 82 -189 315 -318 544 -51 91 -140 245 -198 343 -119 200 -96 182 -267 211 -217 37 -369 48 -755 51 -212 2 -434 -1 -495 -5z" fill="#CD161E"/>
                  </g>
                </svg>
                <span>
                  <span class="text-sm font-medium text-foreground group-hover:text-accent transition-colors block">Centro Documentazione Ivan Donatelli</span>
                  <span class="text-xs text-muted-foreground">Catalogo libri e cataloghi d'arte</span>
                </span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Risorse Associati ABAQ -->
        <div>
          <h3 class="text-foreground mb-5">Risorse Associati + ABAQ</h3>
          <ul class="space-y-3 text-sm">
            <li class="text-muted-foreground">
              <span class="font-medium text-foreground">ZONA FRANCA Study Room</span><br>
              Lun–Sab ore 17:30–19:30
            </li>
            <li class="text-muted-foreground">
              Zines: <em>Osservatorio Futura, Arte&amp;Critica City, E.T. Zine</em>
            </li>
            <li>
              <a href="https://spazio-genesi.github.io/sg_assemblee/" target="_blank" rel="noopener noreferrer"
                class="text-accent hover:opacity-80 transition-opacity underline">Verbali assemblee</a>
            </li>
            <li>
              <a href="https://forms.gle/fmbbhtUQLkwkMjqH9" target="_blank" rel="noopener noreferrer"
                class="text-accent hover:opacity-80 transition-opacity underline">Candidatura mostra personale</a>
            </li>
            <li>
              <a href={u('/newsletter/')}
                class="text-accent hover:opacity-80 transition-opacity underline">Iscrizione mailing list</a>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- ⑥ NEWS TICKER -->
  <div class="bg-background border-t border-border py-2">
    <div class="max-w-7xl mx-auto flex items-center">
      <span class="shrink-0 bg-red-600 text-white text-xs font-semibold px-3 py-2 mr-3">News</span>
      <div class="overflow-hidden text-sm text-muted-foreground">
        <marquee behavior="scroll" direction="left" onmouseover="this.stop();" onmouseout="this.start();">
          Laboratorio permanente di interazione, autogestito, aperto a chi si associa e condivide il progetto —
          rotazione espositiva — archivio donazioni — caffè letterario — assemblea aperta — spazio safe
        </marquee>
      </div>
    </div>
  </div>

</BaseLayout>

<script>
  const slides = document.querySelectorAll<HTMLImageElement>('.carousel-slide')
  const dots = document.querySelectorAll<HTMLButtonElement>('.carousel-dot')
  let current = 0
  let timer: ReturnType<typeof setInterval>

  function goTo(n: number) {
    slides[current].classList.replace('opacity-100', 'opacity-0')
    dots[current].classList.replace('bg-white', 'bg-white/40')
    current = (n + slides.length) % slides.length
    slides[current].classList.replace('opacity-0', 'opacity-100')
    dots[current].classList.replace('bg-white/40', 'bg-white')
  }

  function startAuto() {
    timer = setInterval(() => goTo(current + 1), 3500)
  }

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      clearInterval(timer)
      goTo(Number(dot.dataset.index))
      startAuto()
    })
  })

  // Pausa al hover
  const carousel = document.getElementById('carousel')
  carousel?.addEventListener('mouseenter', () => clearInterval(timer))
  carousel?.addEventListener('mouseleave', startAuto)

  startAuto()
</script>
