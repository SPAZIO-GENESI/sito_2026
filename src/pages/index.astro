---
import BaseLayout from '../layouts/BaseLayout.astro'
import data from '../data/artisti.json'
import { flattenImmagini } from '../types'
import type { Artista } from '../types'

const artisti = data.artisti as Artista[]
const artistiPreview = artisti.slice(0, 3)
const base = import.meta.env.BASE_URL
---
<BaseLayout
  title="Spazio Genesi — Arte Contemporanea, Accademia di Belle Arti L'Aquila"
  description="Spazio Genesi ETS: laboratorio permanente di interazione, autogestito, riservato ad iscritti ABAQ e Erasmus. Arte contemporanea, mostre, biografie."
  activePage=""
>
  <!-- Hero -->
  <section id="hero" class="min-h-[80vh] bg-background overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 py-20 lg:py-32">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <span class="text-accent font-semibold text-sm uppercase tracking-wider">Laboratorio permanente</span>
          <h1 class="mt-4 mb-6 text-foreground">Spazio Genesi</h1>
          <p class="text-lg text-muted-foreground mb-4 leading-relaxed">
            Spazio di interfaccia tra studenti e studentesse dell'Accademia di Belle Arti dell'Aquila.
            Autogestito, multi-manifesto, tutte le tecniche.
          </p>
          <p class="text-base text-muted-foreground mb-8">
            Galleria Via Roma — L'Aquila (AQ)
          </p>
          <div class="flex flex-wrap gap-4">
            <a href={`${base}mostre/`} class="inline-flex items-center gap-2 bg-accent text-accent-foreground px-8 py-3 rounded-lg font-semibold hover:opacity-90 transition-opacity">
              Mostre
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href={`${base}biografie/`} class="inline-flex items-center gap-2 border border-border text-foreground px-8 py-3 rounded-lg font-semibold hover:bg-secondary transition-colors">
              Biografie
            </a>
          </div>
        </div>
        <div>
          {(() => {
            const a = artisti[0]
            const imgs = flattenImmagini(a.img)
            const img = imgs.find(i => i.img)
            return img ? (
              <img
                src={`${base}biografie/${a.cartella}/${img.img}`}
                alt={decodeURIComponent(a.nome)}
                class="w-full rounded-lg shadow-lg object-cover aspect-video"
              />
            ) : null
          })()}
        </div>
      </div>
    </div>
  </section>

  <!-- Artisti in evidenza -->
  <section class="py-20 lg:py-28 bg-secondary">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="mb-16 text-foreground text-center">Artiste e Artisti</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {artistiPreview.map(artista => {
          const imgs = flattenImmagini(artista.img)
          const img = imgs.find(i => i.img)
          const nome = decodeURIComponent(artista.nome)
          return (
            <div class="group">
              <a href={`${base}biografie/${artista.cartella}/`} class="block">
                <div class="overflow-hidden rounded-lg mb-4 aspect-video bg-muted">
                  {img && (
                    <img
                      src={`${base}biografie/${artista.cartella}/${img.img}`}
                      alt={nome}
                      class="w-full h-full object-cover group-hover:opacity-80 transition-opacity"
                      loading="lazy"
                    />
                  )}
                </div>
                <h3 class="text-foreground mb-2">{nome}</h3>
                <p class="text-sm text-accent font-semibold flex items-center gap-2">
                  Biografia
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </p>
              </a>
            </div>
          )
        })}
      </div>
      <div class="text-center mt-12">
        <a href={`${base}biografie/`} class="inline-flex items-center gap-2 text-accent font-semibold hover:opacity-80 transition-opacity">
          Tutte le biografie
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Quick access -->
  <section class="py-20 lg:py-28 bg-background">
    <div class="max-w-7xl mx-auto px-6 lg:px-8">
      <h2 class="mb-16 text-foreground text-center">Esplora</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <a href={`${base}archivio/`} class="group bg-card border border-border rounded-lg p-8 hover:shadow-lg transition-shadow duration-300">
          <div class="flex items-start gap-4 mb-6">
            <div class="p-3 bg-accent/10 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="text-accent" aria-hidden="true">
                <rect width="20" height="5" x="2" y="3" rx="1"/>
                <path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/>
                <path d="M10 12h4"/>
              </svg>
            </div>
          </div>
          <h3 class="text-foreground mb-3">Archivio</h3>
          <p class="text-muted-foreground text-sm leading-relaxed mb-4">
            Cataloghi, documentazione fotografica, rassegna stampa e materiali delle mostre passate.
          </p>
          <span class="text-accent font-semibold text-sm flex items-center gap-2 group-hover:gap-3 transition-all">
            Esplora l'archivio
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>

        <a href={`${base}centrodocumentazione_libri/`} class="group bg-card border border-border rounded-lg p-8 hover:shadow-lg transition-shadow duration-300">
          <div class="flex items-start gap-4 mb-6">
            <div class="p-3 bg-accent/10 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="text-accent" aria-hidden="true">
                <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>
              </svg>
            </div>
          </div>
          <h3 class="text-foreground mb-3">Centro Documentazione</h3>
          <p class="text-muted-foreground text-sm leading-relaxed mb-4">
            Biblioteca Ivan Donatelli: un migliaio di testi, cataloghi, rarità, riviste e fanzine.
          </p>
          <span class="text-accent font-semibold text-sm flex items-center gap-2 group-hover:gap-3 transition-all">
            Sfoglia i libri
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>

        <a href={`${base}attivita/`} class="group bg-card border border-border rounded-lg p-8 hover:shadow-lg transition-shadow duration-300">
          <div class="flex items-start gap-4 mb-6">
            <div class="p-3 bg-accent/10 rounded-lg">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                class="text-accent" aria-hidden="true">
                <path d="M8 2v4"/><path d="M16 2v4"/>
                <rect width="18" height="18" x="3" y="4" rx="2"/>
                <path d="M3 10h18"/>
              </svg>
            </div>
          </div>
          <h3 class="text-foreground mb-3">Attività</h3>
          <p class="text-muted-foreground text-sm leading-relaxed mb-4">
            Talk, workshop, assemblee aperte, eventi conviviali e tutte le attività dello spazio.
          </p>
          <span class="text-accent font-semibold text-sm flex items-center gap-2 group-hover:gap-3 transition-all">
            Vedi le attività
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
              fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <div class="bg-background border-t border-border py-2">
    <div class="max-w-7xl mx-auto flex items-center">
      <span class="shrink-0 bg-red-600 text-white text-xs font-semibold px-3 py-2 mr-3">News</span>
      <div class="overflow-hidden text-sm text-muted-foreground">
        <marquee behavior="scroll" direction="left" onmouseover="this.stop();" onmouseout="this.start();">
          laboratorio permanente di interazione — noi che...voi che...presente e futuro — autogestito —
          riservato ad iscritt* ABAQ + Erasmus — multi manifesto — tutte le tecniche — rotazione espositiva —
          archivio donazioni — caffè letterario — conviviale — assemblea aperta — spazio safe
        </marquee>
      </div>
    </div>
  </div>
</BaseLayout>
